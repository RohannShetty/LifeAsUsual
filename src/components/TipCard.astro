</style>

<script>
  // A fold remembers the card, not the scroll position: reopening a page in the
  // same tab restores only the notes the reader had already opened.
  const NOTES_KEY = 'htlb_notes_open_v1';

  function readOpenNotes(): Set<string> {
    try {
      const raw = sessionStorage.getItem(NOTES_KEY);
      const parsed = raw ? JSON.parse(raw) : [];
      return new Set(
        Array.isArray(parsed) ? parsed.filter((id): id is string => typeof id === 'string') : []
      );
    } catch {
      return new Set();
    }
  }

  function rememberOpenNotes(ids: Set<string>) {
    try {
      sessionStorage.setItem(NOTES_KEY, JSON.stringify([...ids].slice(-40)));
    } catch {
      /* Private mode: the fold still works, it just will not be remembered. */
    }
  }

  const openNotes = readOpenNotes();
  let lastOpened: HTMLElement | null = null;

  function setFold(fold: HTMLElement, open: boolean, animate = true) {
    const toggle = fold.querySelector<HTMLButtonElement>('.notes-toggle');
    const body = fold.querySelector<HTMLElement>('.notes-body');
    if (!toggle || !body) return;

    if (!animate) body.style.transition = 'none';
    toggle.setAttribute('aria-expanded', String(open));
    body.classList.toggle('is-open', open);
    body.inert = !open;
    if (!animate) {
      requestAnimationFrame(() => {
        body.style.transition = '';
      });
    }
  }

  function initFolds() {
    document.querySelectorAll<HTMLElement>('[data-notes-fold]').forEach((fold) => {
      const id = fold.closest<HTMLElement>('.tip-card')?.dataset.tipId ?? '';
      setFold(fold, openNotes.has(id), false);
    });
  }

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement | null;
    if (!target) return;

    const sourcesBtn = target.closest('.sources-toggle-btn');
    if (sourcesBtn) {
      const isExpanded = sourcesBtn.getAttribute('aria-expanded') === 'true';
      sourcesBtn.setAttribute('aria-expanded', String(!isExpanded));
      return;
    }

    const toggle = target.closest<HTMLButtonElement>('.notes-toggle');
    const fold = toggle?.closest<HTMLElement>('[data-notes-fold]');
    if (!toggle || !fold) return;

    const open = toggle.getAttribute('aria-expanded') !== 'true';
    setFold(fold, open);

    const id = fold.closest<HTMLElement>('.tip-card')?.dataset.tipId;
    if (id) {
      if (open) openNotes.add(id);
      else openNotes.delete(id);
      rememberOpenNotes(openNotes);
    }
    if (open) lastOpened = fold;
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape' || !lastOpened) return;
    const body = lastOpened.querySelector('.notes-body');
    if (!body?.classList.contains('is-open')) return;
    setFold(lastOpened, false);
    lastOpened.querySelector<HTMLButtonElement>('.notes-toggle')?.focus();
  });

  initFolds();
  document.addEventListener('astro:page-load', initFolds);
</script>