---
import type { EnglishTip } from '../../scripts/ingest-parveen';
import { resolvePath } from '../utils/paths';
import indiaGuidance from '../../data/india-chapter-guidance.json';

interface Props {
  tip: EnglishTip;
  // A checked Tier A chapter (legal, medical or financial) remains a checked
  // draft until a named human reviewer signs off, so it keeps a draft badge.
  pendingHumanReview?: boolean;
}

const { tip } = Astro.props;
const pendingHumanReview = Astro.props.pendingHumanReview === true;

// Evidence ring styling
const evidenceGrade = tip.evidenceGrade; // A, B, C
const evidenceLabel = `Evidence Grade ${evidenceGrade}`;

// Anchor ID format: #c-t e.g. #1-1
const anchorId = `${tip.chapter}-${tip.tip}`;

// Extract sources count
const sourcesList = tip.sources ? tip.sources.split(';').map(s => s.trim()).filter(Boolean) : [];
const sourcesCount = sourcesList.length;

// ROI tier class mapping
const roiClass = tip.valueTier === 'Very high' ? 'roi-very-high' : tip.valueTier === 'High' ? 'roi-high' : 'roi-average';

// A rewritten India tip carries an India review status. Bridge UI (source
// badge, India note, chapter application) belongs only to source text.
const isIndiaTip =
  tip.reviewStatus === 'draft' ||
  tip.reviewStatus === 'independently-checked' ||
  tip.reviewStatus === 'reviewed';

const chapterGuidance = isIndiaTip
  ? null
  : (indiaGuidance as Record<string, { anchor: string; note: string }>)[String(tip.chapter)];

// Flag tips that describe a source-edition rule, institution or hotline. The
// badge opens the crosswalk; it does not change the author's text.
const sourceSpecific = !isIndiaTip && /\b(dibao|hukou|yibao|shebao|gongjijin|gongshang|laodong|caili|WeChat|Alipay|12308|12315|12321|12377|12389|12309|96110|12356|12355|12348|12333|three[- ]tier|Grade-3)\b/i.test(
  [tip.title, tip.inPlainWords, tip.cost, tip.benefit, tip.caveats].join(' ')
);

// India edition: add the most actionable Indian hotline equivalent in the card
// with a clearly-labelled Indian equivalent. The author's text stays untouched.
const hotlineText = [tip.inPlainWords, tip.cost, tip.caveats].join(' ');
let indiaNote = '';
if (isIndiaTip) {
  indiaNote = '';
} else if (/\b(call|dial|phone|ring|contact)\s+120\b/i.test(hotlineText)) {
  indiaNote = 'In India, call 112 for emergency services, or 108 for an ambulance where available.';
} else if (/\b(call|dial|phone|ring|contact)\s+110\b/i.test(hotlineText)) {
  indiaNote = 'In India, call 112 or 100 for the police.';
} else if (/\b(call|dial|phone|ring|contact)\s+119\b/i.test(hotlineText)) {
  indiaNote = 'In India, call 112 or 101 for the fire service.';
} else if (/\b12308\b/.test(hotlineText)) {
  indiaNote = 'In India, use the MEA MADAD portal and the nearest Indian embassy or consulate.';
} else if (/\b12315\b/.test(hotlineText)) {
  indiaNote = 'In India, call the National Consumer Helpline on 1915.';
} else if (/\b(12356|12355)\b/.test(hotlineText)) {
  indiaNote = 'In India, call Tele-MANAS on 14416 for mental-health support.';
} else if (/\b12348\b/.test(hotlineText)) {
  indiaNote = 'In India, call NALSA legal aid on 15100.';
} else if (/\b96110\b/.test(hotlineText)) {
  indiaNote = 'In India, call 1930 and file at cybercrime.gov.in.';
}
---

<article 
  class="paper tip-card" 
  id={anchorId}
  data-tip-id={tip.id}
  data-chapter={tip.chapter}
  data-tip-num={tip.tip}
>
  <!-- Card Header: Title with Linkable ID & Primary Badges -->
  <header class="tip-header">
    <div class="tip-top-row">
      <!-- Tip Number Badge & Anchored Link -->
      <a href={`#${anchorId}`} class="tip-anchor-link" aria-label={`Permanent link to Tip ${tip.chapter}.${tip.tip}`}>
        <span class="tip-id-badge">{tip.chapter}.{tip.tip}</span>
      </a>

      <!-- Primary Quality Signals: ROI & Evidence Grade -->
      <div class="tip-badges-group">
        <span class={`editorial-badge ${roiClass}`} title="Return on Investment">
          {tip.valueTier} ROI
        </span>

        <span class="editorial-badge grade-badge" title={evidenceLabel}>
          <svg class="evidence-ring" viewBox="0 0 16 16" width="13" height="13" aria-hidden="true">
            <circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="2" fill="none" />
            {evidenceGrade === 'A' && <circle cx="8" cy="8" r="4" fill="currentColor" />}
            {evidenceGrade === 'B' && <path d="M 8 2 A 6 6 0 0 1 8 14 Z" fill="currentColor" />}
          </svg>
          <span>Grade {evidenceGrade}</span>
        </span>

        {tip.disputed && (
          <span class="editorial-badge badge-disputed" title="This recommendation is disputed by subsequent studies">
            Disputed
          </span>
        )}

        {tip.stillVerifying && (
          <span class="editorial-badge badge-verifying" title="Evidence is currently undergoing replication or review">
            Verifying
          </span>
        )}

        {sourceSpecific && (
          <a class="editorial-badge badge-source" href={resolvePath('/india/')} title="This tip describes a rule or institution from the source edition. Open the India rewrite status.">
            Source-specific
          </a>
        )}

        {tip.reviewStatus === 'draft' && (
          <span class="editorial-badge badge-draft" title="Rewritten for India; pending independent verification">
            Draft rewrite
          </span>
        )}

        {tip.reviewStatus === 'independently-checked' && pendingHumanReview && (
          <span class="editorial-badge badge-human-review" title="Checked against official Indian sources; awaiting named human review">
            Draft: human review pending
          </span>
        )}

        {(tip.reviewStatus === 'independently-checked' || tip.reviewStatus === 'reviewed') && (
          <span class="editorial-badge badge-checked" title="Rewritten for India and checked against official Indian sources">
            {tip.reviewStatus === 'reviewed' ? 'Reviewed' : 'Checked'}
          </span>
        )}
      </div>
    </div>

    <!-- Title -->
    <h2 class="tip-title">{tip.title}</h2>

    <!-- Disciplined Editorial Metadata Row -->
    <div class="tip-meta-bar">
      <span class="meta-chip"><span class="meta-label">Scope</span>{tip.tags.scope}</span>
      <span class="meta-chip"><span class="meta-label">Cost</span>{tip.tags.money}</span>
      <span class="meta-chip"><span class="meta-label">Time</span>{tip.tags.time}</span>
      <span class="meta-chip"><span class="meta-label">Effort</span>{tip.tags.willpower}</span>
      {tip.tags.audience && tip.tags.audience.map(aud => (
        <span class="meta-chip meta-audience">{aud}</span>
      ))}
    </div>
  </header>

  <!-- In Plain Words (Core Visual Lead) -->
  <section class="lead-section">
    <p class="in-plain-words">{tip.inPlainWords}</p>
    {indiaNote && (
      <p class="india-tip-note">
        <span class="india-tip-badge">India</span>
        {indiaNote}
        <a href={resolvePath('/india/#helplines')}>All helplines</a>
      </p>
    )}
  </section>

  <!-- Cost & Benefit Analysis -->
  <div class="metrics-grid">
    <div class="metric-block cost-block">
      <span class="metric-label">Cost</span>
      <p class="metric-text">{tip.cost}</p>
    </div>
    <div class="metric-block benefit-block">
      <span class="metric-label">Benefit</span>
      <p class="metric-text">{tip.benefit}</p>
    </div>
  </div>

  <!-- Caveats & Context (Refined Full Border — No Slop Side-Tab) -->
  <section class="caveats-section">
    <span class="caveats-label">Caveats & Context</span>
    <p class="caveats-text">{tip.caveats}</p>
  </section>

  <!-- India application (one chapter-level note shared by every tip in the chapter) -->
  {chapterGuidance && (
    <details class="india-application">
      <summary>
        <span class="india-app-badge">IN</span>
        <span>India application</span>
      </summary>
      <div class="india-app-body">
        <p>{chapterGuidance.note}</p>
        <a href={resolvePath('/india/#' + chapterGuidance.anchor)}>Open the India rewrite status →</a>
      </div>
    </details>
  )}

  <!-- Sources (Smooth Accessible Collapsible) -->
  {sourcesCount > 0 && (
    <section class="sources-section">
      <button 
        type="button" 
        class="sources-toggle-btn" 
        aria-expanded="false" 
        data-target={`sources-${anchorId}`}
      >
        <span class="toggle-text">Sources & Citations ({sourcesCount})</span>
        <svg class="toggle-icon" viewBox="0 0 20 20" width="16" height="16" fill="currentColor">
          <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
        </svg>
      </button>

      <div class="sources-drawer" id={`sources-${anchorId}`}>
        <div class="sources-drawer-inner">
          <ul class="sources-list">
            {sourcesList.map(src => (
              <li class="source-item">
                <span class="source-bullet">•</span>
                <span class="source-content" set:html={src.replace(/(https?:\/\/[^\s>]+)/g, '<a href="$1" target="_blank" rel="noopener noreferrer" class="citation-link">$1</a>')} />
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  )}

  <!-- Footer Actions (All Touch Targets >= 44px) -->
  <footer class="tip-footer">
    <button type="button" class="action-btn mark-read-btn" data-tip-id={tip.id}>
      <svg class="action-icon check-icon" viewBox="0 0 20 20" width="16" height="16" fill="currentColor">
        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
      </svg>
      <span class="btn-text">Mark Read</span>
    </button>

    <button type="button" class="action-btn pick-btn" data-tip-id={tip.id} aria-label="Save to My Picks">
      <svg class="action-icon bookmark-icon" viewBox="0 0 20 20" width="16" height="16" fill="currentColor">
        <path d="M5 4a2 2 0 012-2h6a2 2 0 012 2v14l-5-2.5L5 18V4z" />
      </svg>
      <span class="btn-text">Save</span>
    </button>

    <button type="button" class="action-btn copy-link-btn" data-anchor={anchorId} aria-label="Copy Link">
      <svg class="action-icon link-icon" viewBox="0 0 20 20" width="16" height="16" fill="currentColor">
        <path fill-rule="evenodd" d="M12.586 4.586a2 2 0 112.828 2.828l-3 3a2 2 0 01-2.828 0 1 1 0 00-1.414 1.414 4 4 0 005.656 0l3-3a4 4 0 00-5.656-5.656l-1.5 1.5a1 1 0 101.414 1.414l1.5-1.5zm-5 5a2 2 0 012.828 0 1 1 0 101.414-1.414 4 4 0 00-5.656 0l-3 3a4 4 0 105.656 5.656l1.5-1.5a1 1 0 10-1.414-1.414l-1.5 1.5a2 2 0 11-2.828-2.828l3-3z" clip-rule="evenodd" />
      </svg>
      <span class="btn-text">Copy</span>
    </button>
  </footer>
</article>

<style>
  /* One tip is one entry in a field guide: a ruled page, not a floating card.
     The .paper material supplies the hairline and radius; the background is the
     opaque variant so body copy keeps its 7:1 margin. No shadow, no glow. */
  .tip-card {
    padding: 1.15rem 1rem;
    margin-bottom: 1.1rem;
    transition: border-color var(--dur-fast) var(--ease-out);
    position: relative;
    border-radius: var(--radius-card);
    background: var(--theme-card-strong);
    box-shadow: none;
  }

  .tip-card:hover {
    border-color: color-mix(in srgb, var(--color-jade) 35%, var(--theme-hairline));
  }

  @media (min-width: 640px) {
    .tip-card {
      padding: 1.6rem 1.5rem;
    }
  }

  .tip-header {
    margin-bottom: 1.15rem;
  }

  .tip-top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
  }

  /* Permanent Anchor Link with expanded touch area */
  .tip-anchor-link {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    color: inherit;
    position: relative;
    min-height: 44px;
    min-width: 44px;
  }

  .tip-id-badge {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 0.82rem;
    font-variant-numeric: tabular-nums;
    background: var(--color-ink);
    color: var(--color-mist);
    padding: 2px 7px;
    border-radius: 4px;
    letter-spacing: 0.02em;
    border: 1px solid rgba(255, 255, 255, 0.15);
    transition: background var(--dur-fast), border-color var(--dur-fast);
  }

  .tip-anchor-link:hover .tip-id-badge {
    border-color: var(--color-jade);
    color: var(--color-jade-text);
  }

  :global([data-theme="light"]) .tip-id-badge {
    background: #04110F;
    color: #FFFFFF;
    border-color: transparent;
  }

  /* Refined Editorial Badges */
  .tip-badges-group {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .editorial-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3px 9px;
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    border-radius: var(--radius-capsule);
    border: 1px solid transparent;
  }

  .roi-very-high {
    background: rgba(70, 217, 160, 0.14);
    color: var(--color-jade-text);
    border-color: rgba(70, 217, 160, 0.3);
  }

  .roi-high {
    background: rgba(245, 184, 90, 0.14);
    color: var(--color-amber-text);
    border-color: rgba(245, 184, 90, 0.3);
  }

  .roi-average {
    background: rgba(143, 179, 217, 0.14);
    color: var(--color-steel-text);
    border-color: rgba(143, 179, 217, 0.3);
  }

  .grade-badge {
    background: rgba(255, 255, 255, 0.06);
    color: var(--theme-text);
    border-color: rgba(255, 255, 255, 0.12);
  }

  .evidence-ring {
    color: var(--color-jade-text);
  }

  .badge-disputed {
    background: rgba(255, 107, 107, 0.15);
    color: #FF8787;
    border-color: rgba(255, 107, 107, 0.35);
  }

  .badge-draft,
  .badge-human-review {
    background: color-mix(in srgb, var(--color-steel) 14%, transparent);
    color: var(--color-steel-text);
    border: 1px solid color-mix(in srgb, var(--color-steel) 35%, transparent);
  }

  .badge-checked {
    background: color-mix(in srgb, var(--color-jade) 16%, transparent);
    color: var(--color-jade-text);
    border: 1px solid color-mix(in srgb, var(--color-jade) 45%, transparent);
  }

  .badge-source {
    background: color-mix(in srgb, var(--color-amber) 10%, transparent);
    color: var(--color-amber-text);
    border: 1px dashed color-mix(in srgb, var(--color-amber) 55%, transparent);
    text-decoration: none;
  }

  .badge-source:hover {
    border-style: solid;
    border-color: var(--color-amber);
  }

  .badge-verifying {
    background: rgba(226, 232, 240, 0.1);
    color: #CBD5E1;
    border-color: rgba(226, 232, 240, 0.2);
  }

  :global([data-theme="light"]) .badge-disputed {
    color: #9B1C1C;
  }

  :global([data-theme="light"]) .badge-verifying {
    color: #334155;
  }

  :global([data-theme="light"]) .grade-badge {
    background: rgba(4, 17, 15, 0.05);
    border-color: rgba(4, 17, 15, 0.1);
  }

  :global([data-theme="light"]) .roi-very-high {
    background: rgba(70, 217, 160, 0.2);
    color: #0E7048;
    border-color: rgba(70, 217, 160, 0.4);
  }

  :global([data-theme="light"]) .roi-high {
    background: rgba(245, 184, 90, 0.2);
    color: #925400;
    border-color: rgba(245, 184, 90, 0.4);
  }

  :global([data-theme="light"]) .roi-average {
    background: rgba(143, 179, 217, 0.2);
    color: #26547C;
    border-color: rgba(143, 179, 217, 0.4);
  }

  /* Tip Headline — set in the reading serif, like a heading in a printed book.
     Headline and body then share one voice; the sans is reserved for labels. */
  .tip-title {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.22rem;
    line-height: 1.26;
    letter-spacing: -0.006em;
    color: var(--theme-text);
    margin-bottom: 0.6rem;
    text-wrap: balance;
  }

  @media (min-width: 640px) {
    .tip-title {
      font-size: 1.4rem;
    }
  }

  /* Disciplined Editorial Metadata Row */
  /* Metadata is a caption line, not a row of pills: label and value in one
     tracked line, separated by a hairline slash. */
  .tip-meta-bar {
    display: flex;
    align-items: baseline;
    gap: 0.15rem 0.5rem;
    flex-wrap: wrap;
    font-family: var(--font-sans);
    font-size: 0.7rem;
    line-height: 1.4;
    color: var(--theme-text);
  }

  .meta-chip {
    display: inline-flex;
    align-items: baseline;
    gap: 5px;
    padding: 0;
    border-radius: 0;
    background: none;
    border: 0;
  }

  .meta-chip + .meta-chip::before {
    content: "/";
    color: var(--theme-hairline);
    margin-right: 0.4rem;
    font-size: 0.7rem;
  }

  .meta-label {
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--theme-text-muted);
  }

  .meta-audience {
    color: var(--color-steel-text);
    font-weight: 700;
  }

  /* Visual Lead: In Plain Words */
  .lead-section {
    margin-bottom: 1.25rem;
    padding-bottom: 1.15rem;
    border-bottom: 1px solid rgba(232, 241, 239, 0.1);
  }

  :global([data-theme="light"]) .lead-section {
    border-bottom-color: rgba(4, 17, 15, 0.08);
  }

  .in-plain-words {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.65;
    color: var(--theme-text);
    max-width: var(--text-measure, 65ch);
  }

  .india-tip-note {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 5px;
    margin-top: 0.65rem;
    padding: 0.45rem 0.55rem;
    border-radius: 8px;
    border: 1px solid color-mix(in srgb, var(--color-amber) 30%, transparent);
    background: color-mix(in srgb, var(--color-amber) 8%, transparent);
    font-family: var(--font-sans);
    font-size: 0.7rem;
    line-height: 1.4;
    color: var(--theme-text-muted);
  }

  .india-tip-badge {
    flex: 0 0 auto;
    padding: 1px 4px;
    border-radius: 3px;
    background: var(--color-amber);
    color: var(--color-ink);
    font-size: 0.56rem;
    font-weight: 800;
    letter-spacing: 0.04em;
  }

  .india-tip-note a {
    color: var(--color-amber-text);
    font-weight: 700;
    text-underline-offset: 2px;
  }

  /* Metrics Grid (Cost & Benefit) */
  /* Cost and Benefit are the two ruled columns of the entry, not two boxes
     inside a box. A single hairline across the top, one rule between them. */
  .metrics-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    margin-bottom: 1.15rem;
    border-top: 1px solid var(--theme-hairline);
  }

  .metric-block {
    background: none;
    border: 0;
    border-radius: 0;
    padding: 0.7rem 0 0.5rem;
  }

  .metric-block + .metric-block {
    border-top: 1px solid var(--theme-hairline);
  }

  @media (min-width: 640px) {
    .metrics-grid {
      grid-template-columns: 1fr 1fr;
    }

    .metric-block + .metric-block {
      border-top: 0;
      border-left: 1px solid var(--theme-hairline);
      padding-left: 1.1rem;
    }
  }

  .metric-label {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.6rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    margin-bottom: 0.35rem;
  }

  .cost-block .metric-label {
    color: var(--color-amber-text);
  }

  .benefit-block .metric-label {
    color: var(--color-jade-text);
  }

  .metric-text {
    font-family: var(--font-serif);
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--theme-text);
  }

  /* Caveats & Context (Refined Full Border — Anti-Slop Compliant) */
  .caveats-section {
    margin-bottom: 1.15rem;
    background: none;
    border: 0;
    border-top: 1px solid var(--theme-hairline);
    padding: 0.85rem 0 0;
    border-radius: 0;
  }

  :global([data-theme="light"]) .caveats-section {
    background: none;
    border-color: rgba(38, 84, 124, 0.18);
  }

  .caveats-label {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.74rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-steel-text);
    margin-bottom: 0.35rem;
  }

  :global([data-theme="light"]) .caveats-label {
    color: #26547C;
  }

  .caveats-text {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--theme-text);
  }

  /* India application */
  .india-application {
    margin-bottom: 1rem;
    border-top: 1px solid var(--theme-hairline);
  }

  .india-application summary {
    display: flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding: 0.35rem 0.1rem;
    list-style: none;
    cursor: pointer;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    color: var(--color-jade-text);
  }

  .india-application summary::-webkit-details-marker { display: none; }

  .india-application summary::after {
    content: "+";
    margin-left: auto;
    color: var(--theme-text-muted);
    font-size: 1rem;
  }

  .india-application[open] summary::after { content: "−"; }

  .india-app-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 1px 4px;
    border-radius: 3px;
    background: var(--color-jade);
    color: var(--color-ink);
    font-size: 0.55rem;
    font-weight: 800;
  }

  .india-app-body {
