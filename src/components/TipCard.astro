---
import type { EnglishTip } from '../../scripts/ingest-parveen';

interface Props {
  tip: EnglishTip;
}

const { tip } = Astro.props;

// Evidence ring styling
const evidenceGrade = tip.evidenceGrade; // A, B, C
const evidenceLabel = `Evidence Grade ${evidenceGrade}`;

// Anchor ID format: #c-t e.g. #1-1
const anchorId = `${tip.chapter}-${tip.tip}`;

// Extract sources count
const sourcesList = tip.sources ? tip.sources.split(';').map(s => s.trim()).filter(Boolean) : [];
const sourcesCount = sourcesList.length;

// ROI tier class mapping
const roiClass = tip.valueTier === 'Very high' ? 'roi-very-high' : tip.valueTier === 'High' ? 'roi-high' : 'roi-average';
---

<article 
  class="fake-glass tip-card" 
  id={anchorId}
  data-tip-id={tip.id}
  data-chapter={tip.chapter}
  data-tip-num={tip.tip}
>
  <!-- Card Header: Title with Linkable ID & Primary Badges -->
  <header class="tip-header">
    <div class="tip-top-row">
      <!-- Tip Number Badge & Anchored Link -->
      <a href={`#${anchorId}`} class="tip-anchor-link" aria-label={`Permanent link to Tip ${tip.chapter}.${tip.tip}`}>
        <span class="tip-id-badge">{tip.chapter}.{tip.tip}</span>
      </a>

      <!-- Primary Quality Signals: ROI & Evidence Grade -->
      <div class="tip-badges-group">
        <span class={`editorial-badge ${roiClass}`} title="Return on Investment">
          {tip.valueTier} ROI
        </span>

        <span class="editorial-badge grade-badge" title={evidenceLabel}>
          <svg class="evidence-ring" viewBox="0 0 16 16" width="13" height="13" aria-hidden="true">
            <circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="2" fill="none" />
            {evidenceGrade === 'A' && <circle cx="8" cy="8" r="4" fill="currentColor" />}
            {evidenceGrade === 'B' && <path d="M 8 2 A 6 6 0 0 1 8 14 Z" fill="currentColor" />}
          </svg>
          <span>Grade {evidenceGrade}</span>
        </span>

        {tip.disputed && (
          <span class="editorial-badge badge-disputed" title="This recommendation is disputed by subsequent studies">
            Disputed
          </span>
        )}

        {tip.stillVerifying && (
          <span class="editorial-badge badge-verifying" title="Evidence is currently undergoing replication or review">
            Verifying
          </span>
        )}
      </div>
    </div>

    <!-- Title -->
    <h2 class="tip-title">{tip.title}</h2>

    <!-- Disciplined Editorial Metadata Row -->
    <div class="tip-meta-bar">
      <span class="meta-item"><span class="meta-label">Scope:</span> {tip.tags.scope}</span>
      <span class="meta-sep" aria-hidden="true">·</span>
      <span class="meta-item"><span class="meta-label">Cost:</span> {tip.tags.money}</span>
      <span class="meta-sep" aria-hidden="true">·</span>
      <span class="meta-item"><span class="meta-label">Time:</span> {tip.tags.time}</span>
      <span class="meta-sep" aria-hidden="true">·</span>
      <span class="meta-item"><span class="meta-label">Effort:</span> {tip.tags.willpower}</span>
      {tip.tags.audience && tip.tags.audience.map(aud => (
        <>
          <span class="meta-sep" aria-hidden="true">·</span>
          <span class="meta-item meta-audience">{aud}</span>
        </>
      ))}
    </div>
  </header>

  <!-- In Plain Words (Core Visual Lead) -->
  <section class="lead-section">
    <p class="in-plain-words">{tip.inPlainWords}</p>
  </section>

  <!-- Cost & Benefit Analysis -->
  <div class="metrics-grid">
    <div class="metric-block cost-block">
      <span class="metric-label">Cost</span>
      <p class="metric-text">{tip.cost}</p>
    </div>
    <div class="metric-block benefit-block">
      <span class="metric-label">Benefit</span>
      <p class="metric-text">{tip.benefit}</p>
    </div>
  </div>

  <!-- Caveats & Context (Refined Full Border — No Slop Side-Tab) -->
  <section class="caveats-section">
    <span class="caveats-label">Caveats & Context</span>
    <p class="caveats-text">{tip.caveats}</p>
  </section>

  <!-- Sources (Smooth Accessible Collapsible) -->
  {sourcesCount > 0 && (
    <section class="sources-section">
      <button 
        type="button" 
        class="sources-toggle-btn" 
        aria-expanded="false" 
        data-target={`sources-${anchorId}`}
      >
        <span class="toggle-text">Sources & Citations ({sourcesCount})</span>
        <svg class="toggle-icon" viewBox="0 0 20 20" width="16" height="16" fill="currentColor">
          <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
        </svg>
      </button>

      <div class="sources-drawer" id={`sources-${anchorId}`}>
        <div class="sources-drawer-inner">
          <ul class="sources-list">
            {sourcesList.map(src => (
              <li class="source-item">
                <span class="source-bullet">•</span>
                <span class="source-content" set:html={src.replace(/(https?:\/\/[^\s>]+)/g, '<a href="$1" target="_blank" rel="noopener noreferrer" class="citation-link">$1</a>')} />
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  )}

  <!-- Footer Actions (All Touch Targets >= 44px) -->
  <footer class="tip-footer">
    <button type="button" class="action-btn mark-read-btn" data-tip-id={tip.id}>
      <svg class="action-icon check-icon" viewBox="0 0 20 20" width="16" height="16" fill="currentColor">
        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
      </svg>
      <span class="btn-text">Mark Read</span>
    </button>

    <button type="button" class="action-btn pick-btn" data-tip-id={tip.id} aria-label="Save to My Picks">
      <svg class="action-icon bookmark-icon" viewBox="0 0 20 20" width="16" height="16" fill="currentColor">
        <path d="M5 4a2 2 0 012-2h6a2 2 0 012 2v14l-5-2.5L5 18V4z" />
      </svg>
      <span class="btn-text">Save</span>
    </button>

    <button type="button" class="action-btn copy-link-btn" data-anchor={anchorId} aria-label="Copy Link">
      <svg class="action-icon link-icon" viewBox="0 0 20 20" width="16" height="16" fill="currentColor">
        <path fill-rule="evenodd" d="M12.586 4.586a2 2 0 112.828 2.828l-3 3a2 2 0 01-2.828 0 1 1 0 00-1.414 1.414 4 4 0 005.656 0l3-3a4 4 0 00-5.656-5.656l-1.5 1.5a1 1 0 101.414 1.414l1.5-1.5zm-5 5a2 2 0 012.828 0 1 1 0 101.414-1.414 4 4 0 00-5.656 0l-3 3a4 4 0 105.656 5.656l1.5-1.5a1 1 0 10-1.414-1.414l-1.5 1.5a2 2 0 11-2.828-2.828l3-3z" clip-rule="evenodd" />
      </svg>
      <span class="btn-text">Copy</span>
    </button>
  </footer>
</article>

<style>
  .tip-card {
    padding: 1.5rem 1.35rem;
    margin-bottom: 2rem;
    transition: transform var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out);
    position: relative;
    border-radius: var(--radius-card);
  }

  @media (min-width: 640px) {
    .tip-card {
      padding: 1.75rem 1.65rem;
    }
  }

  .tip-header {
    margin-bottom: 1.15rem;
  }

  .tip-top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
  }

  /* Permanent Anchor Link with expanded touch area */
  .tip-anchor-link {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    color: inherit;
    position: relative;
    min-height: 44px;
    min-width: 44px;
  }

  .tip-id-badge {
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: 0.88rem;
    background: var(--color-ink);
    color: var(--color-mist);
    padding: 3px 8px;
    border-radius: 6px;
    letter-spacing: -0.02em;
    border: 1px solid rgba(255, 255, 255, 0.15);
    transition: background var(--dur-fast), border-color var(--dur-fast);
  }

  .tip-anchor-link:hover .tip-id-badge {
    border-color: var(--color-jade);
    color: var(--color-jade-text);
  }

  [data-theme="light"] .tip-id-badge {
    background: #04110F;
    color: #FFFFFF;
    border-color: transparent;
  }

  /* Refined Editorial Badges */
  .tip-badges-group {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .editorial-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3px 9px;
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    border-radius: var(--radius-capsule);
    border: 1px solid transparent;
  }

  .roi-very-high {
    background: rgba(70, 217, 160, 0.14);
    color: var(--color-jade-text);
    border-color: rgba(70, 217, 160, 0.3);
  }

  .roi-high {
    background: rgba(245, 184, 90, 0.14);
    color: var(--color-amber-text);
    border-color: rgba(245, 184, 90, 0.3);
  }

  .roi-average {
    background: rgba(143, 179, 217, 0.14);
    color: var(--color-steel-text);
    border-color: rgba(143, 179, 217, 0.3);
  }

  .grade-badge {
    background: rgba(255, 255, 255, 0.06);
    color: var(--theme-text);
    border-color: rgba(255, 255, 255, 0.12);
  }

  .evidence-ring {
    color: var(--color-jade-text);
  }

  .badge-disputed {
    background: rgba(255, 107, 107, 0.15);
    color: #FF8787;
    border-color: rgba(255, 107, 107, 0.35);
  }

  .badge-verifying {
    background: rgba(226, 232, 240, 0.1);
    color: #CBD5E1;
    border-color: rgba(226, 232, 240, 0.2);
  }

  [data-theme="light"] .badge-disputed {
    color: #9B1C1C;
  }

  [data-theme="light"] .badge-verifying {
    color: #334155;
  }

  [data-theme="light"] .grade-badge {
    background: rgba(4, 17, 15, 0.05);
    border-color: rgba(4, 17, 15, 0.1);
  }

  [data-theme="light"] .roi-very-high {
    background: rgba(70, 217, 160, 0.2);
    color: #0E7048;
    border-color: rgba(70, 217, 160, 0.4);
  }

  [data-theme="light"] .roi-high {
    background: rgba(245, 184, 90, 0.2);
    color: #925400;
    border-color: rgba(245, 184, 90, 0.4);
  }

  [data-theme="light"] .roi-average {
    background: rgba(143, 179, 217, 0.2);
    color: #26547C;
    border-color: rgba(143, 179, 217, 0.4);
  }

  /* Tip Headline */
  .tip-title {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 1.25rem;
    line-height: 1.35;
    letter-spacing: -0.015em;
    color: var(--theme-text);
    margin-bottom: 0.65rem;
  }

  @media (min-width: 640px) {
    .tip-title {
      font-size: 1.35rem;
    }
  }

  /* Disciplined Editorial Metadata Row */
  .tip-meta-bar {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex-wrap: wrap;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: var(--theme-text-muted);
  }

  .meta-item {
    display: inline-flex;
    align-items: baseline;
    gap: 3px;
  }

  .meta-label {
    font-weight: 600;
    color: var(--theme-text-muted);
    opacity: 0.85;
  }

  .meta-sep {
    opacity: 0.4;
  }

  .meta-audience {
    font-style: italic;
    opacity: 0.85;
  }

  /* Visual Lead: In Plain Words */
  .lead-section {
    margin-bottom: 1.25rem;
    padding-bottom: 1.15rem;
    border-bottom: 1px solid rgba(232, 241, 239, 0.1);
  }

  [data-theme="light"] .lead-section {
    border-bottom-color: rgba(4, 17, 15, 0.08);
  }

  .in-plain-words {
    font-family: var(--font-serif);
    font-size: 1.08rem;
    font-weight: 500;
    line-height: 1.68;
    color: var(--theme-text);
    max-width: var(--text-measure, 65ch);
  }

  /* Metrics Grid (Cost & Benefit) */
  .metrics-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.85rem;
    margin-bottom: 1.15rem;
  }

  @media (min-width: 640px) {
    .metrics-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .metric-block {
    background: rgba(0, 0, 0, 0.16);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 12px;
    padding: 0.85rem 1rem;
  }

  [data-theme="light"] .metric-block {
    background: rgba(0, 0, 0, 0.03);
    border-color: rgba(4, 17, 15, 0.06);
  }

  .metric-label {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.74rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.3rem;
  }

  .cost-block .metric-label {
    color: var(--color-amber-text);
  }

  .benefit-block .metric-label {
    color: var(--color-jade-text);
  }

  .metric-text {
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--theme-text);
  }

  /* Caveats & Context (Refined Full Border — Anti-Slop Compliant) */
  .caveats-section {
    margin-bottom: 1.15rem;
    background: rgba(143, 179, 217, 0.07);
    border: 1px solid rgba(143, 179, 217, 0.22);
    padding: 0.85rem 1.05rem;
    border-radius: 12px;
  }

  [data-theme="light"] .caveats-section {
    background: rgba(38, 84, 124, 0.05);
    border-color: rgba(38, 84, 124, 0.18);
  }

  .caveats-label {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.74rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-steel-text);
    margin-bottom: 0.35rem;
  }

  [data-theme="light"] .caveats-label {
    color: #26547C;
  }

  .caveats-text {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--theme-text);
  }

  /* Sources Drawer Animation */
  .sources-section {
    margin-bottom: 1.15rem;
  }

  .sources-toggle-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 0.65rem 0.95rem;
    min-height: 44px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    color: var(--theme-text-muted);
    font-family: var(--font-sans);
    font-size: 0.84rem;
    cursor: pointer;
    transition: background var(--dur-fast), color var(--dur-fast), border-color var(--dur-fast);
  }

  [data-theme="light"] .sources-toggle-btn {
    background: rgba(4, 17, 15, 0.03);
    border-color: rgba(4, 17, 15, 0.08);
  }

  .sources-toggle-btn:hover {
    background: rgba(255, 255, 255, 0.08);
    color: var(--theme-text);
    border-color: rgba(255, 255, 255, 0.16);
  }

  .toggle-icon {
    transition: transform var(--dur-base) var(--ease-out);
  }

  .sources-toggle-btn[aria-expanded="true"] .toggle-icon {
    transform: rotate(180deg);
  }

  .sources-drawer {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows var(--dur-settle) var(--ease-out);
  }

  .sources-toggle-btn[aria-expanded="true"] + .sources-drawer {
    grid-template-rows: 1fr;
  }

  .sources-drawer-inner {
    overflow: hidden;
  }

  .sources-list {
    list-style: none;
    padding: 0.75rem 0.5rem 0.25rem;
  }

  .source-item {
    display: flex;
    gap: 0.5rem;
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--theme-text-muted);
    margin-bottom: 0.5rem;
  }

  .source-bullet {
    color: var(--color-steel-text);
  }

  :global(.citation-link) {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-steel-text);
    text-decoration: underline;
    word-break: break-all;
  }

  /* Tip Card Footer Actions */
  .tip-footer {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(232, 241, 239, 0.08);
    flex-wrap: wrap;
  }

  [data-theme="light"] .tip-footer {
    border-top-color: rgba(4, 17, 15, 0.08);
  }

  .action-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 8px 16px;
    min-height: 44px; /* Touch target >= 44px */
    border-radius: var(--radius-capsule);
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(255, 255, 255, 0.05);
    color: var(--theme-text);
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: transform var(--dur-fast) var(--ease-out), background var(--dur-fast), border-color var(--dur-fast);
  }

  [data-theme="light"] .action-btn {
    border-color: rgba(4, 17, 15, 0.12);
    background: rgba(4, 17, 15, 0.04);
  }

  .action-btn:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.25);
  }

  .action-btn:active {
    transform: scale(0.96);
  }

  .mark-read-btn.is-read {
    background: var(--color-jade);
    color: var(--color-ink);
    border-color: var(--color-jade);
  }

  .pick-btn.is-picked {
    background: var(--color-amber);
    color: var(--color-ink);
    border-color: var(--color-amber);
  }
</style>

<script>
  // Handle Sources Drawer Expansion on click
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const btn = target.closest('.sources-toggle-btn');
    if (btn) {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!isExpanded));
    }
  });
</script>
