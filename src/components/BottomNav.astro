---
import { resolvePath } from '../utils/paths';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navItems = [
  {
    name: 'Home',
    path: '/',
    href: resolvePath('/'),
    icon: '<svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>'
  },
  {
    name: 'Chapters',
    path: '/chapters/',
    href: resolvePath('/chapters/'),
    icon: '<svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"/><path d="M6 6h10"/><path d="M6 10h10"/></svg>'
  },
  {
    name: 'Explore',
    path: '/explore/',
    href: resolvePath('/explore/'),
    icon: '<svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>'
  },
  {
    name: 'Progress',
    path: '/progress/',
    href: resolvePath('/progress/'),
    icon: '<svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>'
  },
];
---

<nav class="bottom-nav-container" aria-label="Mobile navigation" data-bottom-nav>
  <div class="liquid-glass nav-capsule">
    {navItems.map(item => {
      const isActive = currentPath === item.href || (item.path !== '/' && currentPath.includes(item.path));
      return (
        <a
          href={item.href}
          class:list={['nav-link', { 'is-active': isActive }]}
          aria-current={isActive ? 'page' : undefined}
        >
          <span class="nav-icon" set:html={item.icon} />
          <span class="nav-label">{item.name}</span>
        </a>
      );
    })}

    <span class="nav-divider" aria-hidden="true"></span>

    <button type="button" class="nav-settings" id="open-settings-btn" aria-label="Reading settings" title="Reading settings">
      <svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="3"/>
        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
      </svg>
    </button>
  </div>
</nav>

<style>
  .bottom-nav-container {
    position: fixed;
    bottom: calc(0.7rem + env(safe-area-inset-bottom, 0px));
    left: 0;
    right: 0;
    display: flex;
    justify-content: center;
    z-index: 100;
    padding: 0 0.9rem;
    pointer-events: none;
    transition: transform var(--dur-base) var(--ease-out), opacity var(--dur-base);
  }

  .bottom-nav-container.is-hidden {
    transform: translateY(calc(100% + 1.35rem));
    opacity: 0;
    pointer-events: none;
  }

  @media (min-width: 1024px) {
    .bottom-nav-container { display: none; }
  }

  .nav-capsule {
    display: flex;
    align-items: center;
    width: 100%;
    max-width: 430px;
    height: 62px;
    padding: 0 0.45rem 0 0.3rem;
    border-radius: var(--radius-capsule);
    pointer-events: auto;
    background-color: color-mix(in srgb, var(--theme-bg) 78%, transparent);
    -webkit-backdrop-filter: blur(26px) saturate(170%);
    backdrop-filter: blur(26px) saturate(170%);
  }

  :global([data-theme="light"]) .nav-capsule {
    background-color: color-mix(in srgb, #ffffff 80%, transparent);
  }

  .nav-link {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    min-width: 44px;
    min-height: 48px;
    padding: 3px 4px;
    text-decoration: none;
    color: var(--theme-text-muted);
    background: transparent;
    border: none;
    border-radius: 12px;
    cursor: pointer;
    transition: color var(--dur-fast), transform var(--dur-fast) var(--ease-out);
  }

  .nav-link:active { transform: scale(0.93); }
  .nav-link.is-active { color: var(--color-jade-text); }

  .nav-icon { display: flex; }

  .nav-label {
    font-family: var(--font-sans);
    font-size: 0.67rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .nav-divider {
    width: 1px;
    height: 26px;
    margin: 0 0.2rem;
    background: var(--theme-hairline);
    flex: 0 0 auto;
  }

  .nav-settings {
    flex: 0 0 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--theme-text-muted);
    cursor: pointer;
  }

  .nav-settings:hover,
  .nav-settings:focus-visible {
    color: var(--theme-text);
    background: var(--theme-soft);
  }

  @media (max-width: 370px) {
    .bottom-nav-container { padding: 0 0.5rem; }
    .nav-capsule { height: 58px; padding-inline: 0.2rem; }
    .nav-label { font-size: 0.63rem; }
    .nav-link { padding-inline: 2px; }
  }
</style>

<script>
  function initBottomNav() {
    const nav = document.querySelector<HTMLElement>('[data-bottom-nav]');
    if (!nav || nav.dataset.scrollBound === 'true') return;
    nav.dataset.scrollBound = 'true';

    let lastY = window.scrollY;
    let ticking = false;

    function onScroll() {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(() => {
        const y = window.scrollY;
        const goingDown = y > lastY;
        const pastThreshold = y > 160;
        const sheetOpen = document.getElementById('settings-sheet')?.classList.contains('is-open');
        const filterOpen = document.body.classList.contains('filters-open');

        if (goingDown && pastThreshold && !sheetOpen && !filterOpen) {
          nav?.classList.add('is-hidden');
        } else if (!goingDown || y < 80 || sheetOpen || filterOpen) {
          nav?.classList.remove('is-hidden');
        }

        lastY = y;
        ticking = false;
      });
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('astro:page-load', () => {
      lastY = window.scrollY;
      nav?.classList.remove('is-hidden');
    });
  }

  initBottomNav();
  document.addEventListener('astro:page-load', initBottomNav);
</script>