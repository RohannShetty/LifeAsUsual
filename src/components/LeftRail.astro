---
import { resolvePath } from '../utils/paths';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navItems = [
  { 
    name: 'Home', 
    path: '/',
    href: resolvePath('/'), 
    icon: `<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>` 
  },
  { 
    name: 'Start Here', 
    path: '/start/',
    href: resolvePath('/start/'), 
    icon: `<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/></svg>` 
  },
  { 
    name: 'Chapters', 
    path: '/chapters/',
    href: resolvePath('/chapters/'), 
    icon: `<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"/><path d="M6 6h10"/><path d="M6 10h10"/></svg>` 
  },
  { 
    name: 'Explore', 
    path: '/explore/',
    href: resolvePath('/explore/'), 
    icon: `<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>` 
  },
  { 
    name: 'Progress', 
    path: '/progress/',
    href: resolvePath('/progress/'), 
    icon: `<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>` 
  },
  { 
    name: 'My Picks', 
    path: '/picks/',
    href: resolvePath('/picks/'), 
    icon: `<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>` 
  },
  { 
    name: 'About', 
    path: '/about/',
    href: resolvePath('/about/'), 
    icon: `<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>` 
  },
];
---

<aside class="left-rail-container" aria-label="Desktop Sidebar Navigation">
  <div class="rail-header">
    <a href={resolvePath('/')} class="rail-logo">
      <span class="logo-text">Live Better</span>
      <span class="comic-sticker sticker-benefit" style="font-size: 0.65rem; padding: 1px 6px;">v2</span>
    </a>
  </div>

  <nav class="rail-nav">
    <ul class="rail-nav-list">
      {navItems.map(item => {
        const isActive = currentPath === item.href || (item.path !== '/' && currentPath.includes(item.path));
        return (
          <li>
            <a 
              href={item.href} 
              class={`rail-link ${isActive ? 'is-active' : ''}`}
              aria-current={isActive ? 'page' : undefined}
            >
              <span class="rail-icon" set:html={item.icon} />
              <span class="rail-label">{item.name}</span>
            </a>
          </li>
        );
      })}
    </ul>
  </nav>

  <div class="rail-footer">
    <button type="button" class="rail-settings-btn" id="desktop-settings-btn">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="3"/>
        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
      </svg>
      <span>Settings</span>
    </button>
  </div>
</aside>

<style>
  .left-rail-container {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    width: 240px;
    padding: 2rem 1.25rem;
    flex-direction: column;
    justify-content: space-between;
    background: rgba(8, 23, 28, 0.85);
    border-right: 1px solid rgba(255, 255, 255, 0.08);
    z-index: 50;
  }

  [data-theme="light"] .left-rail-container {
    background: rgba(244, 247, 246, 0.9);
    border-right-color: rgba(4, 17, 15, 0.08);
  }

  @media (min-width: 1024px) {
    .left-rail-container {
      display: flex;
    }
  }

  .rail-header {
    margin-bottom: 2rem;
  }

  .rail-logo {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    font-family: var(--font-comic);
    font-size: 1.45rem;
    color: var(--color-jade);
  }

  .rail-nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .rail-link {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    text-decoration: none;
    color: var(--theme-text-muted);
    font-family: var(--font-sans);
    font-size: 0.92rem;
    font-weight: 600;
    border-radius: 10px;
    transition: background var(--dur-fast), color var(--dur-fast);
  }

  .rail-link:hover {
    background: rgba(255, 255, 255, 0.05);
    color: var(--theme-text);
  }

  .rail-link.is-active {
    background: rgba(70, 217, 160, 0.12);
    color: var(--color-jade);
  }

  .rail-settings-btn {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 10px 14px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 10px;
    background: transparent;
    color: var(--theme-text-muted);
    font-family: var(--font-sans);
    font-size: 0.88rem;
    font-weight: 600;
    cursor: pointer;
    transition: background var(--dur-fast), color var(--dur-fast);
  }

  .rail-settings-btn:hover {
    background: rgba(255, 255, 255, 0.06);
    color: var(--theme-text);
  }
</style>
