---
import fs from 'node:fs';
import path from 'node:path';
import type { EnglishChapter } from '../../scripts/ingest-parveen';
import { resolvePath } from '../utils/paths';

// Load all chapters at build time
const enAllPath = path.resolve('data/en-in/all-chapters.json');
let chapters: EnglishChapter[] = [];
try {
  chapters = JSON.parse(fs.readFileSync(enAllPath, 'utf-8'));
} catch (e) {
  console.warn('Could not load data/en-in/all-chapters.json:', e);
}

// One canonical kolam loop, shared by every cluster. Drawn in a 0 0 100 100
// box as four arcs that meet in cusps at the edge midpoints: each arc is
// struck at 0.66 of its chord, which is longer than half the chord (so the arc
// exists) but shorter than the chord itself (so neighbouring arcs meet at an
// angle). preserveAspectRatio="none" stretches the same path to each cluster,
// and vector-effect keeps the stroke at one device pixel, so no per-cluster
// geometry or media query is needed.
const KOLAM_PATH = (() => {
  const inset = 6;
  const far = 100 - inset;
  const mid = 50;
  const chord = Math.hypot(far - mid, mid - inset);
  const r = (chord * 0.66).toFixed(2);
  return [
    'M ' + mid + ' ' + inset,
    'A ' + r + ' ' + r + ' 0 0 1 ' + far + ' ' + mid,
    'A ' + r + ' ' + r + ' 0 0 1 ' + mid + ' ' + far,
    'A ' + r + ' ' + r + ' 0 0 1 ' + inset + ' ' + mid,
    'A ' + r + ' ' + r + ' 0 0 1 ' + mid + ' ' + inset,
    'Z'
  ].join(' ');
})();
---

<div class="reading-map-card liquid-glass">
  <header class="map-header">
    <div class="map-title-row">
      <h2 class="map-title">Reading Map</h2>
      <span class="comic-sticker sticker-benefit map-stat-chip" id="map-read-counter">
        0 / 765 Beads
      </span>
    </div>
    <p class="map-desc">
      765 glass beads representing every tip in the book. Beads light up as you read. Tap any bead to jump straight to that tip.
    </p>
  </header>

  <!-- Visual Bead Map (765 Glass Beads grouped by Chapter) -->
  <div class="beads-container" aria-hidden="true">
    {chapters.map(ch => (
      <div class="chapter-cluster" data-chapter={ch.chapter}>
        <div class="cluster-header">
          <span class="cluster-num">Ch {ch.chapter}</span>
          <span class="cluster-count">{ch.tips.length}</span>
        </div>
        <div class="cluster-beads">
          <svg
            class="orn-kolam"
            viewBox="0 0 100 100"
            preserveAspectRatio="none"
            aria-hidden="true"
            focusable="false"
          >
            <path class="orn-kolam-base" d={KOLAM_PATH} pathLength="1" />
          <path class="orn-kolam-loop" d={KOLAM_PATH} pathLength="1" />
          </svg>
          {ch.tips.map(tip => (
            <a 
              href={resolvePath(`/chapters/${String(ch.chapter).padStart(2, '0')}-${ch.slug}/#${tip.chapter}-${tip.tip}`)} 
              class="map-bead" 
              data-tip-id={tip.id}
              title={`Tip ${tip.chapter}.${tip.tip}: ${tip.title}`}
              aria-label={`Tip ${tip.chapter}.${tip.tip}: ${tip.title}`}
            >
              <span class="bead-dot"></span>
            </a>
          ))}
        </div>
      </div>
    ))}
  </div>

  <!-- Accessible Table Alternative (Section 6 Requirement) -->
  <details class="sr-only-details">
    <summary>Accessible text summary of reading map</summary>
    <table class="accessibility-table">
      <caption>Reading progress by chapter</caption>
      <thead>
        <tr>
          <th scope="col">Chapter</th>
          <th scope="col">Total Tips</th>
          <th scope="col">Status</th>
        </tr>
      </thead>
      <tbody>
        {chapters.map(ch => (
          <tr>
            <td>{ch.chapter}. {ch.title}</td>
            <td>{ch.tips.length}</td>
            <td id={`sr-ch-${ch.chapter}-status`}>Pending</td>
          </tr>
        ))}
      </tbody>
    </table>
  </details>
</div>

<style>
  .reading-map-card {
    padding: 1rem;
    margin-bottom: 0;
  }

  .map-header {
    margin-bottom: 1.5rem;
  }

  .map-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    margin-bottom: 0.4rem;
    flex-wrap: wrap;
  }

  .map-title {
    font-family: var(--font-sans);
    font-size: 1.1rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--theme-text);
  }

  .map-desc {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    line-height: 1.45;
    color: var(--theme-text-muted);
  }

  .beads-container {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-height: 520px;
    overflow-y: auto;
    padding-right: 0.5rem;
    scrollbar-width: thin;
    scrollbar-color: var(--color-jade-text) transparent;
  }

  .chapter-cluster {
    /* Positioning context for the kolam contour; the bead row is the second
       one, so the loop hugs the beads and never crosses the cluster header. */
    position: relative;
    --kolam-pitch: 20px;
    --kolam-disc: 14px;
    background: rgba(0, 0, 0, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 0.75rem 0.85rem;
  }

  :global([data-theme="light"]) .chapter-cluster {
    background: rgba(0, 0, 0, 0.03);
    border-color: rgba(4, 17, 15, 0.06);
  }

  .cluster-header {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--theme-text-muted);
    margin-bottom: 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .cluster-beads {
    display: flex;
    flex-wrap: wrap;
    /* 14px disc + 6px gutter = the 20px lattice pitch. The kolam contour
       stretches to this box, so keeping the pitch fixed keeps the cusps fixed. */
    gap: calc(var(--kolam-pitch) - var(--kolam-disc));
    position: relative;
  }

  .map-bead {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--kolam-disc);
    height: var(--kolam-disc);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.2);
    box-shadow: inset 0 1px 2px rgba(255, 255, 255, 0.2);
    cursor: pointer;
    text-decoration: none;
    transition: transform var(--dur-fast) var(--spring-overshoot), background var(--dur-fast), box-shadow var(--dur-fast);
  }

  /* 44x44px minimum touch target hit area for mobile fingertips */
  .map-bead::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    min-width: 44px;
    min-height: 44px;
  }

  .map-bead:hover {
    transform: scale(1.35);
    background: rgba(255, 255, 255, 0.35);
  }

  .map-bead.is-read {
    background: var(--color-jade);
    border-color: var(--color-ink);
    box-shadow: 
      0 0 8px rgba(63, 201, 180, 0.6),
      inset 0 1px 1px rgba(255, 255, 255, 0.8);
  }

  :global([data-theme="light"]) .map-bead {
    background: rgba(4, 17, 15, 0.1);
    border-color: rgba(4, 17, 15, 0.2);
  }

  :global([data-theme="light"]) .map-bead.is-read {
    background: var(--color-jade);
    border-color: var(--color-ink);
  }

  /* Accessible Screen Reader Table */
  .sr-only-details {
    margin-top: 1rem;
    font-size: 0.82rem;
    color: var(--theme-text-muted);
  }

  .accessibility-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 0.5rem;
  }

  .accessibility-table th, 
  .accessibility-table td {
    padding: 4px 8px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    text-align: left;
  }
</style>

<script>
  import { subscribeLedger } from '../scripts/storage-ledger';

  function initMapSync() {
    const counter = document.getElementById('map-read-counter');
    const beads = document.querySelectorAll('.map-bead');
    const clusters = document.querySelectorAll<HTMLElement>('.chapter-cluster');

    subscribeLedger((state) => {
      const readSet = new Set(state.readTipIds);
      let count = 0;

      beads.forEach((b) => {
        const bead = b as HTMLElement;
        const tipId = bead.dataset.tipId;
        if (tipId && readSet.has(tipId)) {
          bead.classList.add('is-read');
          count++;
        } else {
          bead.classList.remove('is-read');
        }
      });

      // Kolam contour: one custom property per cluster, consumed as
      // stroke-dashoffset by ornament.css. Per-cluster, never per-bead, so a
      // ledger change still costs one class toggle per bead and nothing else.
      clusters.forEach((cluster) => {
        const clusterBeads = cluster.querySelectorAll<HTMLElement>('.map-bead');
        let readInCluster = 0;
        clusterBeads.forEach((bead) => {
          const tipId = bead.dataset.tipId;
          if (tipId && readSet.has(tipId)) readInCluster++;
        });
        const totalTips = clusterBeads.length;
        cluster.style.setProperty(
          '--kolam-trace',
          totalTips ? (readInCluster / totalTips).toFixed(3) : '0'
        );
      });

      if (counter) {
        counter.textContent = `${count} / 765 Beads`;
      }
    });
  }

  // A 44px target on a 20px bead lattice overlaps other targets and the gaps.
  // Browser hit testing may report the next painted bead or a plain container
  // element even though the pointer is centred over a visible bead. Resolve
  // primary pointer clicks by coordinates across the *entire* map, not only
  // within the chapter of the DOM-reported target.
  //
  // Do not intercept links outside the map, keyboard activation (detail=0),
  // modified clicks for new tabs or clicks further than the hit target.
  function initBeadResolution() {
    const flag = window as unknown as { __beadResolutionBound?: boolean };
    if (flag.__beadResolutionBound) return;
    flag.__beadResolutionBound = true;

    document.addEventListener('click', (event) => {
      if (event.defaultPrevented || event.button !== 0 || event.detail === 0) return;
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      const target = event.target;
      if (!(target instanceof Element)) return;
      const container = target.closest('.beads-container');
      if (!container) return;

      let nearest: HTMLAnchorElement | null = null;
      let best = Infinity;
      for (const bead of container.querySelectorAll<HTMLAnchorElement>('.map-bead')) {
        const rect = bead.getBoundingClientRect();
        // Fully clipped beads can report valid rects outside the inner scroller.
        // Never navigate to an off-screen bead because its rectangle is nearest.
        const viewport = container.getBoundingClientRect();
        if (rect.bottom < viewport.top || rect.top > viewport.bottom) continue;
        const dx = event.clientX - (rect.left + rect.width / 2);
        const dy = event.clientY - (rect.top + rect.height / 2);
        const distance = dx * dx + dy * dy;
        if (distance < best) {
          best = distance;
          nearest = bead;
        }
      }

      // Half the 44px tap area, with a small allowance for the diagonal corners.
      if (!nearest || best > 31 * 31) return;
      const href = nearest.getAttribute('href');
      if (!href) return;
      const targetAnchor = target.closest('.map-bead');
      if (targetAnchor === nearest) return; // Preserve native anchor navigation.
      event.preventDefault();
      window.location.assign(href);
    }, true); // Capture before Astro's client router can follow the wrong overlapping anchor.
  }

  if (typeof window !== 'undefined') {
    document.addEventListener('astro:page-load', initMapSync);
    initBeadResolution();
  }
</script>