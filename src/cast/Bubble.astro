---
export interface Props {
  speaker: 'Plus' | 'Minus';
  text: string;
  tailDirection?: 'left' | 'right' | 'bottom-left' | 'bottom-right';
  class?: string;
  autoDismissSeconds?: number;
}

const {
  speaker,
  text,
  tailDirection = 'bottom-left',
  class: className = '',
  autoDismissSeconds = 6,
} = Astro.props;

const speakerColor = speaker === 'Plus' ? 'var(--color-jade)' : 'var(--color-amber)';
---

<div 
  class={`comic-bubble-wrapper speaker-${speaker.toLowerCase()} tail-${tailDirection} ${className}`}
  data-bubble
  data-dismiss-after={autoDismissSeconds}
  role="status"
  aria-live="polite"
>
  <div class="bubble-content liquid-glass">
    <div class="bubble-header">
      <span class="speaker-tag" style={`color: ${speakerColor};`}>
        {speaker}
      </span>
      <button type="button" class="bubble-close-btn" aria-label="Dismiss message">✕</button>
    </div>
    <p class="bubble-text">{text}</p>
    <div class="bubble-tail" aria-hidden="true"></div>
  </div>
</div>

<script>
  function setupBubbles() {
    const bubbles = document.querySelectorAll<HTMLElement>('[data-bubble]');
    
    bubbles.forEach((bubble) => {
      // Tap to dismiss
      const closeBtn = bubble.querySelector('.bubble-close-btn');
      const dismiss = () => {
        bubble.classList.add('is-dismissing');
        setTimeout(() => bubble.remove(), 250);
      };

      if (closeBtn) {
        closeBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          dismiss();
        });
      }

      bubble.addEventListener('click', () => {
        dismiss();
      });

      // Auto-dismiss timer
      const seconds = parseFloat(bubble.dataset.dismissAfter || '6');
      if (seconds > 0) {
        setTimeout(() => {
          if (document.body.contains(bubble)) {
            dismiss();
          }
        }, seconds * 1000);
      }
    });
  }

  // Setup on initial load & view transitions
  setupBubbles();
  document.addEventListener('astro:page-load', setupBubbles);
</script>

<style>
  .comic-bubble-wrapper {
    position: relative;
    display: inline-block;
    max-width: 280px;
    z-index: 40;
    cursor: pointer;
    user-select: none;
    animation: bubblePop 280ms var(--ease-out) forwards;
  }

  .bubble-content {
    position: relative;
    padding: 0.75rem 1rem 0.85rem;
    background: var(--color-glass-fill);
    border: 2px solid #04110F;
    border-radius: var(--radius-card);
    box-shadow: 3px 3px 0 #04110F;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .bubble-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.35rem;
  }

  .speaker-tag {
    font-family: var(--font-display);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .bubble-close-btn {
    background: none;
    border: none;
    font-size: 0.75rem;
    color: var(--color-ink-muted);
    cursor: pointer;
    padding: 0 0.2rem;
    line-height: 1;
  }

  .bubble-close-btn:hover {
    color: var(--theme-text);
  }

  .bubble-text {
    font-family: var(--font-body);
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--theme-text);
    margin: 0;
  }

  /* Ink Comic Tail */
  .bubble-tail {
    position: absolute;
    width: 0;
    height: 0;
    pointer-events: none;
  }

  .tail-bottom-left .bubble-tail {
    bottom: -10px;
    left: 20px;
    border-left: 10px solid transparent;
    border-right: 2px solid transparent;
    border-top: 10px solid #04110F;
  }

  .tail-bottom-right .bubble-tail {
    bottom: -10px;
    right: 20px;
    border-right: 10px solid transparent;
    border-left: 2px solid transparent;
    border-top: 10px solid #04110F;
  }

  .tail-left .bubble-tail {
    left: -10px;
    top: 50%;
    transform: translateY(-50%);
    border-top: 6px solid transparent;
    border-bottom: 6px solid transparent;
    border-right: 10px solid #04110F;
  }

  .tail-right .bubble-tail {
    right: -10px;
    top: 50%;
    transform: translateY(-50%);
    border-top: 6px solid transparent;
    border-bottom: 6px solid transparent;
    border-left: 10px solid #04110F;
  }

  @keyframes bubblePop {
    0% {
      opacity: 0;
      transform: scale(0.85) translateY(6px);
    }
    100% {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  .is-dismissing {
    animation: bubbleDismiss 200ms var(--ease-out) forwards !important;
  }

  @keyframes bubbleDismiss {
    0% {
      opacity: 1;
      transform: scale(1);
    }
    100% {
      opacity: 0;
      transform: scale(0.8) translateY(-4px);
    }
  }

  /* Comic Effects Off toggle suppression */
  :global([data-comic-effects="false"]) .comic-bubble-wrapper {
    display: none !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .comic-bubble-wrapper,
    .is-dismissing {
      animation: none !important;
      transition: opacity 150ms ease !important;
    }
  }
</style>
