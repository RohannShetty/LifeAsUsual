---
import { ClientRouter } from 'astro:transitions';
import BottomNav from '../components/BottomNav.astro';
import LeftRail from '../components/LeftRail.astro';
import SettingsSheet from '../components/SettingsSheet.astro';
import { resolvePath } from '../utils/paths';

import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/glass.css';
import '../styles/comic.css';
import '../styles/ui.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "How To Live Better", 
  description = "Spend the least money, time and effort to get back the most lifespan, money and personal freedom." 
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en" data-theme="dark" data-palette="midnight" data-comic-effects="on" data-show-inr="true">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href={resolvePath('favicon.svg')} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#08171C" id="theme-color-meta" />

    <!-- Apply saved theme before first paint (no flash) -->
    <script is:inline>
      (function () {
        try {
          var raw = localStorage.getItem('htlb_settings_v1');
          var saved = raw ? JSON.parse(raw) : {};
          var mode = saved.theme || 'dark';
          if (mode === 'auto') {
            mode = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          var palette = saved.palette || (mode === 'light' ? 'pearl' : 'midnight');
          var lightPalettes = ['pearl', 'ivory'];
          var isLightPalette = lightPalettes.indexOf(palette) !== -1;
          if ((mode === 'light') !== isLightPalette) {
            palette = mode === 'light' ? 'pearl' : 'midnight';
          }
          document.documentElement.setAttribute('data-theme', mode);
          document.documentElement.setAttribute('data-palette', palette);
          document.documentElement.setAttribute('data-show-inr', saved.inrReference === false ? 'false' : 'true');
          var meta = document.getElementById('theme-color-meta');
          if (meta) meta.setAttribute('content', mode === 'light' ? '#F2F6F4' : '#08171C');
        } catch (e) {}
      })();
    </script>

    <!-- View Transitions -->
    <ClientRouter />

    <script is:inline define:vars={{ baseUrl: import.meta.env.BASE_URL }}>
      // Intercept any root-relative links to guarantee subpath routing on GitHub Pages
      if (baseUrl && baseUrl !== '/') {
        const cleanBase = baseUrl.replace(/\/$/, '');
        document.addEventListener('click', (e) => {
          const a = e.target.closest('a');
          if (a) {
            const href = a.getAttribute('href');
            if (href && href.startsWith('/') && !href.startsWith('//') && !href.startsWith(cleanBase)) {
              a.setAttribute('href', cleanBase + href);
            }
          }
        }, true);
      }
    </script>
  </head>
  <body class="theme-root">
    <a href="#main-content" class="skip-link">Skip to content</a>
    <!-- Desktop Left Rail -->
    <LeftRail currentPath={currentPath} />

    <!-- Main Content Column -->
    <div class="app-layout-shell">
      <main class="reading-column" id="main-content" tabindex="-1" data-pagefind-body>
        <slot />
      </main>
    </div>

    <!-- Mobile Floating Bottom Nav -->
    <BottomNav currentPath={currentPath} />

    <!-- Reading Settings Sheet -->
    <SettingsSheet />

    <!-- Client-side reading tracker island -->
    <script>
      import '../scripts/read-tracker';
      import '../scripts/inr';
    </script>
  </body>
</html>

<style is:global>
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    font-size: 16px;
    -webkit-text-size-adjust: 100%;
  }

  body {
    background-color: var(--theme-bg);
    color: var(--theme-text);
    font-family: var(--font-serif);
    font-size: var(--text-body-size);
    line-height: var(--text-body-lh);
    min-height: 100dvh;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }

  .skip-link {
    position: absolute;
    left: 1rem;
    top: -4rem;
    z-index: 200;
    padding: 0.75rem 1.25rem;
    border-radius: var(--radius-capsule);
    background: var(--color-jade);
    color: var(--color-ink);
    font-family: var(--font-sans);
    font-weight: 700;
    text-decoration: none;
    transition: top var(--dur-fast) var(--ease-out);
  }

  .skip-link:focus-visible {
    top: 1rem;
  }

  .app-layout-shell {
    min-height: 100dvh;
    display: flex;
    justify-content: center;
    padding-bottom: calc(5.5rem + env(safe-area-inset-bottom, 0px));
  }

  @media (min-width: 1024px) {
    .app-layout-shell {
      margin-left: 240px; /* Offset for LeftRail */
      padding-bottom: 3rem;
    }
  }

  .reading-column {
    width: 100%;
    max-width: 760px;
    padding: 1.5rem 1rem;
  }

  @media (min-width: 640px) {
    .reading-column {
      padding: 2.5rem 1.5rem;
    }
  }

  /* View Transitions Comic Panel Wipe */
  ::view-transition-old(root) {
    animation: 350ms var(--ease-out) both panel-wipe-out;
  }

  ::view-transition-new(root) {
    animation: 350ms var(--ease-out) both panel-wipe-in;
  }

  @keyframes panel-wipe-out {
    from {
      opacity: 1;
      transform: translateX(0) scale(1);
    }
    to {
      opacity: 0;
      transform: translateX(-40px) scale(0.98);
    }
  }

  @keyframes panel-wipe-in {
    from {
      opacity: 0;
      transform: translateX(40px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateX(0) scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    ::view-transition-old(root),
    ::view-transition-new(root) {
      animation: 150ms ease-out both fade;
    }

    @keyframes fade {
      from { opacity: 0; }
      to { opacity: 1; }
    }
  }
</style>