---
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import TipCard from '../components/TipCard.astro';
import Character from '../cast/Character.astro';
import Bubble from '../cast/Bubble.astro';
import type { EnglishChapter, EnglishTip } from '../../scripts/ingest-parveen';
import { resolvePath } from '../utils/paths';

const enAllPath = path.resolve('data/en/all-chapters.json');
let allTips: EnglishTip[] = [];
try {
  const chapters: EnglishChapter[] = JSON.parse(fs.readFileSync(enAllPath, 'utf-8'));
  for (const chapter of chapters) {
    allTips.push(...chapter.tips);
  }
} catch (e) {
  console.warn('Could not load tips for explore:', e);
}
---

<BaseLayout
  title="Explore 765 Tips - How To Live Better"
  description="Search and filter 765 evidence-graded tips by payoff, evidence grade, cost, time, effort, audience and verification status."
>
  <div class="explore-container">
    <header class="explore-header">
      <div class="explore-topline">
        <span class="section-kicker">Explore</span>
        <a class="finder-link" href={resolvePath('/#find-your-step')}>Not sure? Answer 3 questions →</a>
      </div>
      <h1 class="page-title">Find the tip you need.</h1>
      <p class="page-lead">Search all 765 tips, or narrow by what you can afford in money, time and effort.</p>
    </header>

    <section class="explore-controls liquid-glass" aria-label="Search and quick filters">
      <div class="search-input-wrapper">
        <span class="search-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        </span>
        <input
          type="search"
          id="explore-search"
          class="explore-search-input"
          placeholder="Search sleep, salt, rent, insurance…"
          aria-label="Search tips"
          autocomplete="off"
        />
        <button type="button" id="clear-search-btn" class="clear-btn" aria-label="Clear search">✕</button>
      </div>

      <div class="quick-row">
        <button type="button" class="filter-trigger" id="open-filter-sheet" aria-haspopup="dialog" aria-controls="filter-sheet">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6h16M7 12h10M10 18h4"/></svg>
          <span>Filters</span>
          <span class="filter-count" id="active-filter-count" hidden>0</span>
        </button>

        <div class="quick-chips" role="group" aria-label="Quick filters">
          <button type="button" class="quick-chip is-active" data-quick="all">All</button>
          <button type="button" class="quick-chip" data-quick="best">Best ROI</button>
          <button type="button" class="quick-chip" data-quick="free">Free</button>
          <button type="button" class="quick-chip" data-quick="quick">Quick</button>
        </div>
      </div>

      <p class="active-summary" id="active-summary" hidden></p>
    </section>

    <div class="results-head">
      <span class="results-count" id="results-count">Showing 765 of 765 tips</span>
      <button type="button" id="reset-filters-btn" class="reset-link">Reset</button>
    </div>

    <div id="explore-empty-state" class="empty-box liquid-glass" hidden>
      <div class="empty-cast-row">
        <Character character="minus" mood="surprised" size={54} />
        <Bubble speaker="Minus" text="Nothing matches. Loosen one filter." tailDirection="left" autoDismissSeconds={0} />
      </div>
      <h2 class="empty-title">No tips match those filters</h2>
      <p class="empty-desc">Try a broader term, or clear one or two filters. “Sleep”, “salt”, “rent” and “insurance” are good starting searches.</p>
      <button type="button" id="empty-reset-btn" class="ui-btn ui-btn-primary">Clear all filters</button>
    </div>

    <main id="explore-results-feed" class="tips-stream">
      {allTips.map((tip) => (
        <div
          class="explore-tip-item"
          data-id={tip.id}
          data-evidence={tip.evidenceGrade}
          data-tier={tip.valueTier}
          data-scope={tip.tags.scope}
          data-cost={tip.tags.money}
          data-time={tip.tags.time}
          data-willpower={tip.tags.willpower}
          data-audience={(tip.tags.audience || []).join(',')}
          data-disputed={tip.disputed ? 'true' : 'false'}
          data-verifying={tip.stillVerifying ? 'true' : 'false'}
          data-title={tip.title.toLowerCase()}
          data-plain={tip.inPlainWords.toLowerCase()}
          data-benefit={tip.benefit.toLowerCase()}
        >
          <TipCard tip={tip} />
        </div>
      ))}
      <div id="explore-scroll-sentinel" class="scroll-sentinel" hidden>
        <span class="sentinel-badge">Loading more tips…</span>
      </div>
    </main>
  </div>

  <div class="filter-backdrop" id="filter-backdrop" aria-hidden="true"></div>

  <aside
    id="filter-sheet"
    class="filter-sheet liquid-glass"
    role="dialog"
    aria-modal="true"
    aria-labelledby="filter-title"
    aria-hidden="true"
  >
    <header class="filter-sheet-head">
      <div>
        <p class="section-kicker">Narrow it down</p>
        <h2 id="filter-title" class="filter-title">Filters</h2>
      </div>
      <button type="button" class="filter-close" id="close-filter-sheet" aria-label="Close filters">✕</button>
    </header>

    <div class="filter-sheet-body">
      <div class="filter-group">
        <span class="filter-label">Evidence grade</span>
        <div class="filter-chips" data-filter="evidence">
          <button type="button" class="filter-chip active" data-value="all">All</button>
          <button type="button" class="filter-chip chip-a" data-value="A">Grade A · 495</button>
          <button type="button" class="filter-chip chip-b" data-value="B">Grade B · 218</button>
          <button type="button" class="filter-chip chip-c" data-value="C">Grade C · 52</button>
        </div>
      </div>

      <div class="filter-group">
        <span class="filter-label">Payoff tier</span>
        <div class="filter-chips" data-filter="tier">
          <button type="button" class="filter-chip active" data-value="all">All</button>
          <button type="button" class="filter-chip" data-value="Very high">Very high · 122</button>
          <button type="button" class="filter-chip" data-value="High">High · 344</button>
          <button type="button" class="filter-chip" data-value="Average">Average · 299</button>
        </div>
      </div>

      <div class="filter-group">
        <span class="filter-label">What you get back</span>
        <div class="filter-chips" data-filter="scope">
          <button type="button" class="filter-chip active" data-value="all">All</button>
          <button type="button" class="filter-chip" data-value="Lifespan">Lifespan</button>
          <button type="button" class="filter-chip" data-value="Money">Money</button>
          <button type="button" class="filter-chip" data-value="Time and energy">Time &amp; energy</button>
          <button type="button" class="filter-chip" data-value="Personal freedom">Freedom</button>
        </div>
      </div>

      <div class="filter-group">
        <span class="filter-label">Money cost</span>
        <div class="filter-chips" data-filter="cost">
          <button type="button" class="filter-chip active" data-value="all">All</button>
          <button type="button" class="filter-chip" data-value="Free">Free</button>
          <button type="button" class="filter-chip" data-value="Small cost">Small cost</button>
          <button type="button" class="filter-chip" data-value="Real money">Real money</button>
        </div>
      </div>

      <div class="filter-group">
        <span class="filter-label">Time needed</span>
        <div class="filter-chips" data-filter="time">
          <button type="button" class="filter-chip active" data-value="all">All</button>
          <button type="button" class="filter-chip" data-value="Quick">Quick</button>
          <button type="button" class="filter-chip" data-value="A few hours">A few hours</button>
          <button type="button" class="filter-chip" data-value="Takes time every day">Daily</button>
        </div>
      </div>

      <div class="filter-group">
        <span class="filter-label">Willpower</span>
        <div class="filter-chips" data-filter="willpower">
          <button type="button" class="filter-chip active" data-value="all">All</button>
          <button type="button" class="filter-chip" data-value="None needed">None</button>
          <button type="button" class="filter-chip" data-value="Some">Some</button>
          <button type="button" class="filter-chip" data-value="A lot">A lot</button>
        </div>
      </div>

      <div class="filter-group">
        <span class="filter-label">Who it is for</span>
        <div class="filter-chips" data-filter="audience">
          <button type="button" class="filter-chip active" data-value="all">All</button>
          <button type="button" class="filter-chip" data-value="Pregnant or planning">Pregnant / planning</button>
          <button type="button" class="filter-chip" data-value="Child under 3">Child under 3</button>
          <button type="button" class="filter-chip" data-value="Child 3 to 18">Child 3–18</button>
          <button type="button" class="filter-chip" data-value="Older relatives at home">Older relatives</button>
          <button type="button" class="filter-chip" data-value="Age 35+">Age 35+</button>
          <button type="button" class="filter-chip" data-value="Age 60+">Age 60+</button>
          <button type="button" class="filter-chip" data-value="Women">Women</button>
        </div>
      </div>

      <div class="filter-group">
        <span class="filter-label">Editorial status</span>
        <div class="filter-chips" data-filter="status">
          <button type="button" class="filter-chip active" data-value="all">All</button>
          <button type="button" class="filter-chip chip-disputed" data-value="disputed">Disputed · 88</button>
          <button type="button" class="filter-chip" data-value="verifying">Still verifying · 3</button>
        </div>
      </div>
    </div>

    <footer class="filter-sheet-foot">
      <button type="button" id="filter-clear" class="filter-clear">Clear all</button>
      <button type="button" id="filter-apply" class="ui-btn ui-btn-primary filter-apply">Show 765 tips</button>
    </footer>
  </aside>
</BaseLayout>

<script>
  function initExplore() {
    document.body.classList.remove('filters-open');
    document.body.style.overflow = '';

    const searchInput = document.getElementById('explore-search') as HTMLInputElement | null;
    const clearBtn = document.getElementById('clear-search-btn');
    const resetBtn = document.getElementById('reset-filters-btn');
    const emptyResetBtn = document.getElementById('empty-reset-btn');
    const resultsCountEl = document.getElementById('results-count');
    const emptyStateEl = document.getElementById('explore-empty-state');
    const sentinelEl = document.getElementById('explore-scroll-sentinel');
    const tipItems = Array.from(document.querySelectorAll<HTMLElement>('.explore-tip-item'));

    if (!tipItems.length) return;

    const sheet = document.getElementById('filter-sheet');
    const backdrop = document.getElementById('filter-backdrop');
    const openSheetBtn = document.getElementById('open-filter-sheet');
    const closeSheetBtn = document.getElementById('close-filter-sheet');
    const clearSheetBtn = document.getElementById('filter-clear');
    const applySheetBtn = document.getElementById('filter-apply');
    const activeCountEl = document.getElementById('active-filter-count');
    const activeSummaryEl = document.getElementById('active-summary');

    const BATCH_SIZE = 25;
    let visibleLimit = BATCH_SIZE;
    let matchedItems: HTMLElement[] = [];
    let filterTimeout: number | null = null;
    let rafId: number | null = null;

    const filters = {
      query: '',
      evidence: 'all',
      tier: 'all',
      scope: 'all',
      cost: 'all',
      audience: 'all',
      time: 'all',
      willpower: 'all',
      status: 'all',
    };

    const params = new URLSearchParams(window.location.search);
    if (params.get('q')) filters.query = params.get('q') || '';
    if (params.get('evidence')) filters.evidence = params.get('evidence') || 'all';
    if (params.get('tier')) filters.tier = params.get('tier') || 'all';
    if (params.get('scope')) filters.scope = params.get('scope') || 'all';
    if (params.get('cost')) filters.cost = params.get('cost') || 'all';
    if (params.get('audience')) filters.audience = params.get('audience') || 'all';
    if (params.get('time')) filters.time = params.get('time') || 'all';
    if (params.get('willpower')) filters.willpower = params.get('willpower') || 'all';
    if (params.get('status')) filters.status = params.get('status') || 'all';

    if (searchInput) searchInput.value = filters.query;

    function updateURL() {
      const p = new URLSearchParams();
      if (filters.query) p.set('q', filters.query);
      if (filters.evidence !== 'all') p.set('evidence', filters.evidence);
      if (filters.tier !== 'all') p.set('tier', filters.tier);
      if (filters.scope !== 'all') p.set('scope', filters.scope);
      if (filters.cost !== 'all') p.set('cost', filters.cost);
      if (filters.audience !== 'all') p.set('audience', filters.audience);
      if (filters.time !== 'all') p.set('time', filters.time);
      if (filters.willpower !== 'all') p.set('willpower', filters.willpower);
      if (filters.status !== 'all') p.set('status', filters.status);

      const newUrl = p.toString() ? window.location.pathname + '?' + p.toString() : window.location.pathname;
      window.history.replaceState({}, '', newUrl);
    }

    function activeFilters(): Array<{ key: string; value: string; label: string }> {
      const out: Array<{ key: string; value: string; label: string }> = [];
      const labels: Record<string, Record<string, string>> = {
        evidence: { A: 'Grade A', B: 'Grade B', C: 'Grade C' },
        tier: { 'Very high': 'Very high', High: 'High', Average: 'Average' },
        scope: { Lifespan: 'Lifespan', Money: 'Money', 'Time and energy': 'Time & energy', 'Personal freedom': 'Freedom' },
        cost: { Free: 'Free', 'Small cost': 'Small cost', 'Real money': 'Real money' },
        time: { Quick: 'Quick', 'A few hours': 'A few hours', 'Takes time every day': 'Daily' },
        willpower: { 'None needed': 'No willpower', Some: 'Some effort', 'A lot': 'A lot of effort' },
        audience: {},
        status: { disputed: 'Disputed', verifying: 'Verifying' },
      };
      (['evidence', 'tier', 'scope', 'cost', 'time', 'willpower', 'audience', 'status'] as const).forEach((key) => {
        const value = filters[key];
        if (value !== 'all') {
          const label = labels[key]?.[value] || value;
          out.push({ key, value, label });
        }
      });
      return out;
    }

    function syncUi() {
      document.querySelectorAll<HTMLElement>('.filter-chips').forEach((group) => {
        const type = group.dataset.filter as keyof typeof filters;
        if (!type) return;
        group.querySelectorAll<HTMLButtonElement>('.filter-chip').forEach((chip) => {
          const selected = chip.dataset.value === filters[type];
          chip.classList.toggle('active', selected);
          chip.setAttribute('aria-pressed', selected ? 'true' : 'false');
        });
      });

      const active = activeFilters();
      if (activeCountEl) {
        activeCountEl.textContent = String(active.length);
        activeCountEl.hidden = active.length === 0;
      }

      if (activeSummaryEl) {
        activeSummaryEl.hidden = active.length === 0;
        activeSummaryEl.textContent = active.length ? active.map((item) => item.label).join(' · ') : '';
      }

      document.querySelectorAll<HTMLButtonElement>('.quick-chip').forEach((chip) => {
        const q = chip.dataset.quick;
        let selected = false;
        if (q === 'all') selected = filters.tier === 'all' && filters.cost === 'all' && filters.time === 'all' && filters.willpower === 'all';
        if (q === 'best') selected = filters.tier === 'Very high';
        if (q === 'free') selected = filters.cost === 'Free';
        if (q === 'quick') selected = filters.time === 'Quick';
        chip.classList.toggle('is-active', selected);
        chip.setAttribute('aria-pressed', selected ? 'true' : 'false');
      });

      if (applySheetBtn) {
        applySheetBtn.textContent = 'Show ' + matchedItems.length + (matchedItems.length === 1 ? ' tip' : ' tips');
      }
    }

    function renderBatch() {
      tipItems.forEach((item) => { item.style.display = 'none'; });

      for (let i = 0; i < Math.min(visibleLimit, matchedItems.length); i++) {
        matchedItems[i].style.display = '';
      }

      if (resultsCountEl) {
        resultsCountEl.textContent = 'Showing ' + matchedItems.length + ' of ' + tipItems.length + ' tips';
      }

      if (emptyStateEl) {
        emptyStateEl.hidden = matchedItems.length !== 0;
      }

      if (sentinelEl) {
        const remaining = matchedItems.length - Math.min(visibleLimit, matchedItems.length);
        sentinelEl.hidden = remaining <= 0;
        const badge = sentinelEl.querySelector('.sentinel-badge');
        if (badge) {
          badge.textContent = 'Loaded ' + Math.min(visibleLimit, matchedItems.length) + ' of ' + matchedItems.length + ' tips. Scroll for more…';
        }
      }
    }

    function applyFilters() {
      const q = filters.query.toLowerCase().trim();
      matchedItems = [];

      tipItems.forEach((item) => {
        const evidence = item.dataset.evidence;
        const tier = item.dataset.tier;
        const scope = item.dataset.scope;
        const cost = item.dataset.cost;
        const time = item.dataset.time;
        const willpower = item.dataset.willpower;
        const audienceRaw = item.dataset.audience || '';
        const audienceList = audienceRaw ? audienceRaw.split(',') : [];
        const isDisputed = item.dataset.disputed === 'true';
        const isVerifying = item.dataset.verifying === 'true';

        const title = item.dataset.title || '';
        const plain = item.dataset.plain || '';
        const benefit = item.dataset.benefit || '';

        const matchesEvidence = filters.evidence === 'all' || evidence === filters.evidence;
        const matchesTier = filters.tier === 'all' || tier === filters.tier;
        const matchesScope = filters.scope === 'all' || scope === filters.scope;
        const matchesCost = filters.cost === 'all' || cost === filters.cost;
        const matchesTime = filters.time === 'all' || time === filters.time;
        const matchesWillpower = filters.willpower === 'all' || willpower === filters.willpower;
        const matchesAudience = filters.audience === 'all' || audienceList.includes(filters.audience);

        let matchesStatus = true;
        if (filters.status === 'disputed') matchesStatus = isDisputed;
        else if (filters.status === 'verifying') matchesStatus = isVerifying;

        const matchesQuery = !q || title.includes(q) || plain.includes(q) || benefit.includes(q);

        if (matchesEvidence && matchesTier && matchesScope && matchesCost && matchesTime && matchesWillpower && matchesAudience && matchesStatus && matchesQuery) {
          matchedItems.push(item);
        }
      });

      visibleLimit = BATCH_SIZE;
      renderBatch();
      syncUi();
      updateURL();
    }

    function debouncedApplyFilters() {
      if (filterTimeout) clearTimeout(filterTimeout);
      filterTimeout = window.setTimeout(() => {
        if (rafId) cancelAnimationFrame(rafId);
        rafId = requestAnimationFrame(() => applyFilters());
      }, 120);
    }

    let sentinelObserver: IntersectionObserver | null = null;
    if (sentinelEl) {
      sentinelObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && visibleLimit < matchedItems.length) {
            visibleLimit += BATCH_SIZE;
            renderBatch();
          }
        });
      }, { rootMargin: '400px' });
      sentinelObserver.observe(sentinelEl);
    }

    function openSheet() {
      sheet?.classList.add('is-open');
      backdrop?.classList.add('is-open');
      sheet?.setAttribute('aria-hidden', 'false');
      backdrop?.setAttribute('aria-hidden', 'false');
      document.body.classList.add('filters-open');
      document.body.style.overflow = 'hidden';
      closeSheetBtn?.focus({ preventScroll: true });
    }

    function closeSheet() {
      sheet?.classList.remove('is-open');
      backdrop?.classList.remove('is-open');
      sheet?.setAttribute('aria-hidden', 'true');
      backdrop?.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('filters-open');
      document.body.style.overflow = '';
    }

    function resetAll() {
      filters.query = '';
      filters.evidence = 'all';
      filters.tier = 'all';
      filters.scope = 'all';
      filters.cost = 'all';
      filters.audience = 'all';
      filters.time = 'all';
      filters.willpower = 'all';
      filters.status = 'all';
      if (searchInput) searchInput.value = '';
      applyFilters();
    }

    searchInput?.addEventListener('input', () => {
      filters.query = searchInput.value;
      debouncedApplyFilters();
    });

    clearBtn?.addEventListener('click', () => {
      if (searchInput) {
        searchInput.value = '';
        filters.query = '';
        applyFilters();
        searchInput.focus();
      }
    });

    document.querySelectorAll<HTMLElement>('.filter-chips').forEach((group) => {
      const type = group.dataset.filter as keyof typeof filters;
      if (!type) return;

      group.addEventListener('click', (event) => {
        const target = (event.target as HTMLElement).closest<HTMLButtonElement>('.filter-chip');
        if (!target) return;
        filters[type] = target.dataset.value || 'all';
        applyFilters();
      });
    });

    document.querySelectorAll<HTMLButtonElement>('.quick-chip').forEach((chip) => {
      chip.addEventListener('click', () => {
        const q = chip.dataset.quick;
        if (q === 'all') {
          filters.tier = 'all';
          filters.cost = 'all';
          filters.time = 'all';
          filters.willpower = 'all';
          filters.status = 'all';
        }
        if (q === 'best') filters.tier = filters.tier === 'Very high' ? 'all' : 'Very high';
        if (q === 'free') filters.cost = filters.cost === 'Free' ? 'all' : 'Free';
        if (q === 'quick') filters.time = filters.time === 'Quick' ? 'all' : 'Quick';
        applyFilters();
      });
    });

    openSheetBtn?.addEventListener('click', openSheet);
    closeSheetBtn?.addEventListener('click', closeSheet);
    backdrop?.addEventListener('click', closeSheet);
    applySheetBtn?.addEventListener('click', () => {
      closeSheet();
      document.getElementById('explore-results-feed')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
    clearSheetBtn?.addEventListener('click', () => {
      filters.evidence = 'all';
      filters.tier = 'all';
      filters.scope = 'all';
      filters.cost = 'all';
      filters.audience = 'all';
      filters.time = 'all';
      filters.willpower = 'all';
      filters.status = 'all';
      applyFilters();
    });

    resetBtn?.addEventListener('click', resetAll);
    emptyResetBtn?.addEventListener('click', resetAll);

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && sheet?.classList.contains('is-open')) closeSheet();
    });

    applyFilters();
  }

  initExplore();
  document.addEventListener('astro:page-load', initExplore);
</script>

<style>
  .explore-container {
    max-width: 860px;
    margin: 0 auto;
    padding: 0.25rem 0 4rem;
  }

  .explore-header { margin-bottom: 1.1rem; }

  .explore-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 0.45rem;
  }

  .finder-link {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--color-jade-text);
    text-decoration: none;
  }

  .finder-link:hover { text-decoration: underline; text-underline-offset: 2px; }

  .page-title {
    font-family: var(--font-sans);
    font-size: clamp(1.85rem, 6vw, 2.5rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.04em;
    color: var(--theme-text);
    margin: 0 0 0.4rem;
  }

  .page-lead {
    max-width: 56ch;
    font-family: var(--font-serif);
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--theme-text-muted);
  }

  .explore-controls {
    padding: 0.8rem;
    border-radius: 18px;
    margin-bottom: 0.7rem;
  }

  .search-input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }

  .search-icon {
    position: absolute;
    left: 0.85rem;
    display: flex;
    color: var(--theme-text-muted);
    pointer-events: none;
  }

  .explore-search-input {
    width: 100%;
    min-height: 46px;
    padding: 0.65rem 2.6rem 0.65rem 2.5rem;
    border-radius: 999px;
    background: var(--theme-soft);
    border: 1px solid var(--theme-hairline);
    color: var(--theme-text);
    font-family: var(--font-sans);
