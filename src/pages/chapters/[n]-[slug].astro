---
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TipCard from '../../components/TipCard.astro';
import type { EnglishChapter } from '../../../scripts/ingest-parveen';

export async function getStaticPaths() {
  const enAllPath = path.resolve('data/en/all-chapters.json');
  const chapters: EnglishChapter[] = JSON.parse(fs.readFileSync(enAllPath, 'utf-8'));

  return chapters.map((ch, index) => {
    const prevChapter = index > 0 ? chapters[index - 1] : null;
    const nextChapter = index < chapters.length - 1 ? chapters[index + 1] : null;

    return {
      params: {
        n: String(ch.chapter).padStart(2, '0'),
        slug: ch.slug,
      },
      props: {
        chapter: ch,
        prevChapter,
        nextChapter,
      },
    };
  });
}

interface Props {
  chapter: EnglishChapter;
  prevChapter: EnglishChapter | null;
  nextChapter: EnglishChapter | null;
}

const { chapter, prevChapter, nextChapter } = Astro.props;
---

<BaseLayout 
  title={`Chapter ${chapter.chapter}: ${chapter.title} - How To Live Better`}
  description={`Read Chapter ${chapter.chapter}: ${chapter.title}. ${chapter.tips.length} verified life recommendations.`}
>
  <!-- Slim Sticky Chapter Header -->
  <aside class="sticky-chapter-header liquid-glass" aria-label="Chapter progress">
    <div class="header-inner">
      <div class="header-titles">
        <span class="chapter-badge">Ch {chapter.chapter}</span>
        <h2 class="chapter-subheading">{chapter.title}</h2>
      </div>
      <div class="header-actions">
        <button type="button" class="on-page-btn" id="open-toc-btn" aria-label="On this page">
          <svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor">
            <path fill-rule="evenodd" d="M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 10a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 15a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z" clip-rule="evenodd" />
          </svg>
          <span>Tips ({chapter.tips.length})</span>
        </button>
      </div>
    </div>
    <!-- Scroll Progress Indicator Bar -->
    <div class="chapter-progress-track">
      <div class="chapter-progress-bar" id="chapter-progress-bar"></div>
    </div>
  </aside>

  <article class="chapter-content">
    <!-- Dismissible Mainland China Legal Disclaimer (Section 3) -->
    <div class="china-disclaimer-banner" id="china-disclaimer">
      <div class="disclaimer-text">
        <strong>Notice:</strong> Written for mainland China. Laws, insurance, medical systems, and procedures elsewhere may differ.
      </div>
      <button type="button" class="dismiss-banner-btn" id="dismiss-disclaimer-btn" aria-label="Dismiss disclaimer">
        ✕
      </button>
    </div>

    <!-- Chapter Hero -->
    <header class="chapter-hero">
      <span class="comic-sticker sticker-benefit">Chapter {chapter.chapter} of 34</span>
      <h1 class="chapter-main-title">{chapter.title}</h1>
      <p class="chapter-meta-line">
        {chapter.tips.length} verified tips in this chapter. Each tip is an option, not an assignment.
      </p>
    </header>

    <!-- Tips List -->
    <section class="tips-stream">
      {chapter.tips.map(tip => (
        <TipCard tip={tip} />
      ))}
    </section>

    <!-- Chapter Pagination -->
    <nav class="chapter-pagination" aria-label="Previous and Next Chapters">
      {prevChapter ? (
        <a 
          href={`/chapters/${String(prevChapter.chapter).padStart(2, '0')}-${prevChapter.slug}/`} 
          class="pagination-card liquid-glass prev-card"
        >
          <span class="pagination-sub">← Previous Chapter</span>
          <span class="pagination-title">Ch {prevChapter.chapter}. {prevChapter.title}</span>
        </a>
      ) : <div />}

      {nextChapter && (
        <a 
          href={`/chapters/${String(nextChapter.chapter).padStart(2, '0')}-${nextChapter.slug}/`} 
          class="pagination-card liquid-glass next-card"
        >
          <span class="pagination-sub">Next Chapter →</span>
          <span class="pagination-title">Ch {nextChapter.chapter}. {nextChapter.title}</span>
        </a>
      )}
    </nav>
  </article>

  <!-- "On This Page" Bottom Sheet / Drawer -->
  <div id="toc-backdrop" class="toc-backdrop" aria-hidden="true"></div>
  <aside id="toc-sheet" class="liquid-glass toc-sheet" aria-modal="true" aria-hidden="true" role="dialog">
    <div class="toc-header">
      <h3 class="toc-title">On This Page</h3>
      <button type="button" id="close-toc-btn" class="close-btn" aria-label="Close table of contents">✕</button>
    </div>
    <ul class="toc-list">
      {chapter.tips.map(tip => (
        <li class="toc-item">
          <a href={`#${tip.chapter}-${tip.tip}`} class="toc-link" data-tip-id={tip.id}>
            <span class="toc-dot" id={`toc-dot-${tip.id}`}></span>
            <span class="toc-num">{tip.chapter}.{tip.tip}</span>
            <span class="toc-text">{tip.title}</span>
          </a>
        </li>
      ))}
    </ul>
  </aside>
</BaseLayout>

<style>
  .sticky-chapter-header {
    position: sticky;
    top: 0.5rem;
    z-index: 40;
    margin-bottom: 1.5rem;
    border-radius: var(--radius-capsule);
    padding: 0.5rem 1rem;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .header-titles {
    display: flex;
    align-items: center;
    gap: 8px;
    overflow: hidden;
  }

  .chapter-badge {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 800;
    background: var(--color-ink);
    color: var(--color-jade);
    padding: 2px 7px;
    border-radius: 6px;
    white-space: nowrap;
  }

  .chapter-subheading {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--theme-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .on-page-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 10px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: var(--radius-capsule);
    color: var(--theme-text);
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
  }

  .chapter-progress-track {
    width: 100%;
    height: 3px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 2px;
    margin-top: 6px;
    overflow: hidden;
  }

  .chapter-progress-bar {
    height: 100%;
    width: 0%;
    background: var(--color-jade);
    transition: width 150ms linear;
  }

  /* Disclaimer Banner */
  .china-disclaimer-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(245, 184, 90, 0.12);
    border: 1px solid rgba(245, 184, 90, 0.35);
    color: var(--theme-text);
    padding: 0.65rem 1rem;
    border-radius: 12px;
    margin-bottom: 2rem;
    font-size: 0.85rem;
    line-height: 1.45;
  }

  .dismiss-banner-btn {
    background: transparent;
    border: none;
    color: var(--theme-text-muted);
    font-size: 1rem;
    cursor: pointer;
    padding: 0 4px;
  }

  /* Chapter Hero */
  .chapter-hero {
    margin-bottom: 2.5rem;
  }

  .chapter-main-title {
    font-family: var(--font-comic);
    font-size: 2.1rem;
    line-height: 1.2;
    color: var(--theme-text);
    margin: 0.75rem 0 0.5rem;
  }

  .chapter-meta-line {
    font-size: 0.95rem;
    color: var(--theme-text-muted);
  }

  /* Pagination */
  .chapter-pagination {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: 3rem;
  }

  @media (min-width: 640px) {
    .chapter-pagination {
      grid-template-columns: 1fr 1fr;
    }
  }

  .pagination-card {
    display: flex;
    flex-direction: column;
    padding: 1.25rem;
    text-decoration: none;
    color: var(--theme-text);
  }

  .pagination-sub {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-jade);
    margin-bottom: 0.3rem;
  }

  .pagination-title {
    font-family: var(--font-sans);
    font-size: 0.98rem;
    font-weight: 700;
  }

  /* On this page drawer */
  .toc-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    opacity: 0;
    pointer-events: none;
    z-index: 150;
    transition: opacity var(--dur-base) var(--ease-out);
  }

  .toc-backdrop.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .toc-sheet {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    max-width: 520px;
    margin: 0 auto;
    max-height: 75vh;
    border-radius: var(--radius-outer) var(--radius-outer) 0 0;
    padding: 1.25rem 1rem calc(1.5rem + env(safe-area-inset-bottom, 0px));
    transform: translateY(105%);
    transition: transform var(--dur-settle) var(--spring-overshoot);
    z-index: 200;
    display: flex;
    flex-direction: column;
  }

  .toc-sheet.is-open {
    transform: translateY(0);
  }

  .toc-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    margin-bottom: 0.75rem;
  }

  .toc-title {
    font-family: var(--font-comic);
    font-size: 1.2rem;
    color: var(--color-jade);
  }

  .toc-list {
    list-style: none;
    overflow-y: auto;
    padding-right: 0.5rem;
  }

  .toc-item {
    margin-bottom: 0.4rem;
  }

  .toc-link {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 8px;
    text-decoration: none;
    color: var(--theme-text-muted);
    font-family: var(--font-sans);
    font-size: 0.85rem;
    border-radius: 8px;
    transition: background var(--dur-fast), color var(--dur-fast);
  }

  .toc-link:hover {
    background: rgba(255, 255, 255, 0.08);
    color: var(--theme-text);
  }

  .toc-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.2);
    flex-shrink: 0;
  }

  .toc-dot.is-read {
    background: var(--color-jade);
    box-shadow: 0 0 6px var(--color-jade);
  }

  .toc-num {
    font-weight: 700;
    font-size: 0.8rem;
    color: var(--color-steel);
    flex-shrink: 0;
  }

  .toc-text {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>

<script>
  import { subscribeLedger } from '../../scripts/storage-ledger';

  function initChapterPage() {
    // Scroll progress bar
    const progressBar = document.getElementById('chapter-progress-bar');
    window.addEventListener('scroll', () => {
      const scrollTotal = document.documentElement.scrollHeight - window.innerHeight;
      const progress = scrollTotal > 0 ? (window.scrollY / scrollTotal) * 100 : 0;
      if (progressBar) progressBar.style.width = `${Math.min(100, Math.max(0, progress))}%`;
    }, { passive: true });

    // Disclaimer dismiss
    const banner = document.getElementById('china-disclaimer');
    const dismissBtn = document.getElementById('dismiss-disclaimer-btn');
    if (sessionStorage.getItem('htlb_dismiss_disclaimer') === 'true') {
      banner?.remove();
    }
    dismissBtn?.addEventListener('click', () => {
      banner?.remove();
      sessionStorage.setItem('htlb_dismiss_disclaimer', 'true');
    });

    // TOC drawer
    const tocSheet = document.getElementById('toc-sheet');
    const tocBackdrop = document.getElementById('toc-backdrop');
    const openTocBtn = document.getElementById('open-toc-btn');
    const closeTocBtn = document.getElementById('close-toc-btn');

    function openToc() {
      tocSheet?.classList.add('is-open');
      tocBackdrop?.classList.add('is-open');
    }

    function closeToc() {
      tocSheet?.classList.remove('is-open');
      tocBackdrop?.classList.remove('is-open');
    }

    openTocBtn?.addEventListener('click', openToc);
    closeTocBtn?.addEventListener('click', closeToc);
    tocBackdrop?.addEventListener('click', closeToc);

    // Sync TOC dots
    subscribeLedger((state) => {
      const readSet = new Set(state.readTipIds);
      document.querySelectorAll('.toc-link').forEach((link) => {
        const tipId = (link as HTMLElement).dataset.tipId;
        const dot = link.querySelector('.toc-dot');
        if (tipId && dot) {
          if (readSet.has(tipId)) {
            dot.classList.add('is-read');
          } else {
            dot.classList.remove('is-read');
          }
        }
      });
    });

    // Close TOC on clicking link
    document.querySelectorAll('.toc-link').forEach((link) => {
      link.addEventListener('click', closeToc);
    });
  }

  if (typeof window !== 'undefined') {
    document.addEventListener('astro:page-load', initChapterPage);
  }
</script>
