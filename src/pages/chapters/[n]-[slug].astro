---
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TipCard from '../../components/TipCard.astro';
import Character from '../../cast/Character.astro';
import Bubble from '../../cast/Bubble.astro';
import IndiaNotice from '../../components/IndiaNotice.astro';
import calmChapters from '../../../data/calm-chapters.json';
import manifest from '../../../data/en-in/manifest.json';
import type { EnglishChapter } from '../../../scripts/ingest-parveen';
import { resolvePath } from '../../utils/paths';

export async function getStaticPaths() {
  const enAllPath = path.resolve('data/en-in/all-chapters.json');
  const chapters: EnglishChapter[] = JSON.parse(fs.readFileSync(enAllPath, 'utf-8'));

  return chapters.map((ch, index) => {
    const prevChapter = index > 0 ? chapters[index - 1] : null;
    const nextChapter = index < chapters.length - 1 ? chapters[index + 1] : null;

    return {
      params: {
        n: String(ch.chapter).padStart(2, '0'),
        slug: ch.slug,
      },
      props: {
        chapter: ch,
        prevChapter,
        nextChapter,
      },
    };
  });
}

interface Props {
  chapter: EnglishChapter;
  prevChapter: EnglishChapter | null;
  nextChapter: EnglishChapter | null;
}

const { chapter, prevChapter, nextChapter } = Astro.props;
const isCalm = calmChapters.includes(chapter.chapter);
const isIndiaRewrite = chapter.edition === 'india';
const rewriteStatus = (chapter as { rewriteStatus?: string }).rewriteStatus ?? 'draft';
const isCheckedChapter = rewriteStatus === 'checked' || rewriteStatus === 'reviewed';
// Tier A chapters (legal, medical, financial) cannot be reviewed without a named
// human reviewer, so a checked Tier A chapter stays a checked draft in the UI.
const manifestEntry = (manifest as { chapters: Record<string, { tier?: string; humanReview?: string }> }).chapters[String(chapter.chapter)];
const pendingHumanReview =
  isIndiaRewrite && isCheckedChapter && manifestEntry?.tier === 'A' && manifestEntry?.humanReview !== 'signed-off';
---

<BaseLayout 
  title={`Chapter ${chapter.chapter}: ${chapter.title} - How To Live Better`}
  description={`Read Chapter ${chapter.chapter}: ${chapter.title}. ${chapter.tips.length} ${isIndiaRewrite ? 'India-rewritten draft' : 'verified'} life recommendations.`}
>
  <div data-calm-chapter={isCalm ? "true" : "false"} class="chapter-page-root">
  <!-- Slim Sticky Chapter Header -->
  <aside class="sticky-chapter-header liquid-glass" aria-label="Chapter progress">
    <div class="header-inner">
      <div class="header-titles">
        <span class="chapter-badge">Ch {chapter.chapter}</span>
        <p class="chapter-subheading">{chapter.title}</p>
      </div>
      <div class="header-actions">
        <button type="button" class="on-page-btn" id="open-toc-btn">
          <svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor">
            <path fill-rule="evenodd" d="M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 10a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 15a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z" clip-rule="evenodd" />
          </svg>
          <span>Tips ({chapter.tips.length})</span>
        </button>
      </div>
    </div>
    <!-- Scroll Progress Indicator Bar -->
    <div class="chapter-progress-track">
      <div class="chapter-progress-bar" id="chapter-progress-bar"></div>
    </div>
  </aside>

  <article class="chapter-content">
    {isIndiaRewrite ? (
      <aside class="rewrite-notice" id="india-rewrite-notice" data-rewrite-status={rewriteStatus}>
        <span class="rewrite-badge">IN</span>
        {pendingHumanReview ? (
          <p><strong>India rewrite.</strong> This chapter has been rewritten for Indian law and practice and checked against official Indian sources. It covers legal, medical or financial claims, so it stays a checked draft until a named human reviewer signs off. <a href={resolvePath('/india/')}>Coverage and sources →</a></p>
        ) : isCheckedChapter ? (
          <p><strong>India rewrite.</strong> This chapter has been rewritten for Indian law and practice and checked against official Indian sources. <a href={resolvePath('/india/')}>Coverage and sources →</a></p>
        ) : (
          <p><strong>India rewrite.</strong> This chapter has been rewritten for Indian law and practice. It is a draft pending independent verification. <a href={resolvePath('/india/')}>Coverage and sources →</a></p>
        )}
      </aside>
    ) : (
      <IndiaNotice id="india-disclaimer" />
    )}

    <!-- Chapter Hero -->
    <header class="chapter-hero">
      <span class="comic-sticker sticker-benefit">Chapter {chapter.chapter} of 34</span>
      <h1 class="chapter-main-title">{chapter.title}</h1>
      <p class="chapter-meta-line">
        {isIndiaRewrite
          ? chapter.tips.length + ' tips rewritten for India; ' + (pendingHumanReview ? 'checked against official Indian sources; human review pending.' : isCheckedChapter ? 'checked against official Indian sources.' : 'drafts pending independent verification.')
          : chapter.tips.length + ' verified tips in this chapter. Each tip is an option, not an assignment.'}
      </p>
    </header>

    <!-- Tips List -->
    <section class="tips-stream">
      {chapter.tips.map(tip => (
        <TipCard tip={tip} pendingHumanReview={pendingHumanReview} />
      ))}
    </section>

    <!-- Chapter Celebration (Non-Calm Chapters Only) -->
    {!isCalm && (
      <section class="chapter-celebration liquid-glass" id="chapter-celebration" aria-label="Chapter Completion Celebration">
        <div class="celebration-cast">
          <Character character="plus" mood="cheering" size={60} />
          <Bubble speaker="Plus" text="Chapter finished! Look at that wave!" tailDirection="bottom-left" />
          <Character character="minus" mood="happy" size={60} />
        </div>
      </section>
    )}

    <!-- Chapter Pagination -->
    <nav class="chapter-pagination" aria-label="Previous and Next Chapters">
      {prevChapter ? (
        <a 
          href={resolvePath(`/chapters/${String(prevChapter.chapter).padStart(2, '0')}-${prevChapter.slug}/`)} 
          class="pagination-card paper prev-card"
        >
          <span class="pagination-sub">← Previous Chapter</span>
          <span class="pagination-title">Ch {prevChapter.chapter}. {prevChapter.title}</span>
        </a>
      ) : <div />}

      {nextChapter && (
        <a 
          href={resolvePath(`/chapters/${String(nextChapter.chapter).padStart(2, '0')}-${nextChapter.slug}/`)} 
          class="pagination-card paper next-card"
        >
          <span class="pagination-sub">Next Chapter →</span>
          <span class="pagination-title">Ch {nextChapter.chapter}. {nextChapter.title}</span>
        </a>
      )}
    </nav>
  </article>

  <!-- "On This Page" Bottom Sheet / Drawer -->
  <div id="toc-backdrop" class="toc-backdrop" aria-hidden="true"></div>
  <aside id="toc-sheet" class="liquid-glass toc-sheet" aria-modal="true" aria-hidden="true" role="dialog" inert>
    <div class="toc-header">
      <h3 class="toc-title">On This Page</h3>
      <button type="button" id="close-toc-btn" class="close-btn" aria-label="Close table of contents">✕</button>
    </div>
    <ul class="toc-list">
      {chapter.tips.map(tip => (
        <li class="toc-item">
          <a href={`#${tip.chapter}-${tip.tip}`} class="toc-link" data-tip-id={tip.id}>
            <span class="toc-dot" id={`toc-dot-${tip.id}`}></span>
            <span class="toc-num">{tip.chapter}.{tip.tip}</span>
            <span class="toc-text">{tip.title}</span>
          </a>
        </li>
      ))}
    </ul>
  </aside>
  </div>
</BaseLayout>

<style>
  .sticky-chapter-header {
    position: sticky;
    top: 0.5rem;
    z-index: 40;
    margin-bottom: 1.5rem;
    border-radius: var(--radius-capsule);
    padding: 0.5rem 1rem;
    transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s ease;
    will-change: transform;
  }

  .sticky-chapter-header.is-scrolled-hidden {
    transform: translateY(-120%);
    opacity: 0;
    pointer-events: none;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .header-titles {
    display: flex;
    align-items: center;
    gap: 8px;
    overflow: hidden;
  }

  .chapter-badge {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 800;
    background: var(--color-ink);
    color: var(--color-jade);
    padding: 2px 7px;
    border-radius: 6px;
    white-space: nowrap;
  }

  .chapter-subheading {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    margin: 0;
    font-weight: 700;
    color: var(--theme-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .on-page-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    min-height: 44px;
    background: var(--theme-soft);
    border: 1px solid var(--theme-hairline);
    border-radius: var(--radius-capsule);
    color: var(--theme-text);
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 700;
    cursor: pointer;
    white-space: nowrap;
  }

  .chapter-progress-track {
    width: 100%;
    height: 3px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 2px;
    margin-top: 6px;
    overflow: hidden;
  }

  .chapter-progress-bar {
    height: 100%;
    width: 0%;
    background: var(--color-jade);
    transition: width 150ms linear;
  }

  .close-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: var(--theme-soft);
    border: 1px solid var(--theme-hairline);
    border-radius: 50%;
    color: var(--theme-text);
    cursor: pointer;
    transition: background var(--dur-fast);
    flex-shrink: 0;
  }

  .close-btn:hover {
    background: rgba(255, 255, 255, 0.15);
  }

  /* India rewrite notice */
  .rewrite-notice {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    padding: 0.6rem 0.7rem;
    margin-bottom: 1.15rem;
    border: 1px solid color-mix(in srgb, var(--color-jade) 34%, transparent);
    background: color-mix(in srgb, var(--color-jade) 9%, var(--theme-card));
    border-radius: 12px;
    color: var(--theme-text);
    font-family: var(--font-sans);
    font-size: 0.78rem;
    line-height: 1.45;
  }

  .rewrite-badge {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 30px;
    height: 20px;
    padding: 0 5px;
    margin-top: 1px;
    border-radius: 4px;
    background: var(--color-jade);
    color: var(--color-ink);
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.04em;
  }

  .rewrite-notice p { flex: 1; margin: 0; }
  .rewrite-notice a { color: var(--color-jade-text); font-weight: 700; }

  /* Chapter Hero
     An opener reads as an opener: a hairline with a short jade flag on top, the
     title set in the serif at true optical size, and the meta line demoted to a
     tracked sans caption. No new data, no new element — only the rule and the
     two type roles change. */
  .chapter-hero {
    position: relative;
    margin: 0.25rem 0 2rem;
    padding-top: 1.6rem;
  }

  .chapter-hero::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--theme-hairline);
  }

  .chapter-hero::after {
    content: "";
    position: absolute;
    top: -1px;
    left: 0;
    width: 4.5rem;
    height: 3px;
    background: var(--color-jade-text);
  }

  .chapter-main-title {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: clamp(1.85rem, 6.2vw, 2.6rem);
    line-height: 1.1;
    letter-spacing: -0.012em;
    color: var(--theme-text);
    margin: 0.8rem 0 0.6rem;
    overflow-wrap: break-word;
    text-wrap: balance;
  }

  .chapter-meta-line {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    line-height: 1.5;
    letter-spacing: 0.005em;
    color: var(--theme-text-muted);
    max-width: 52ch;
  }

  /* Chapter Celebration */
  .chapter-celebration {
    padding: 2rem 1.5rem;
    margin: 2.5rem 0 2rem;
    border-radius: var(--radius-card);
    text-align: center;
    background: var(--color-glass-fill);
    border: 2px solid #04110F;
    box-shadow: 3px 3px 0 #04110F;
  }

  .celebration-cast {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  /* Calm Mode Suppression */
  [data-calm-chapter="true"] .chapter-celebration,
  [data-calm-chapter="true"] .comic-bubble-wrapper,
  [data-calm-chapter="true"] .character-wrapper {
    display: none !important;
  }

  /* Pagination */
  .chapter-pagination {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: 3rem;
  }

  @media (min-width: 640px) {
    .chapter-pagination {
      grid-template-columns: 1fr 1fr;
    }
  }

  .pagination-card {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 72px;
    padding: 1.15rem 1.25rem;
    text-decoration: none;
    color: var(--theme-text);
    border-radius: var(--radius-card);
    transition: transform var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out);
  }

  .pagination-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-jade);
  }

  .pagination-sub {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-jade-text);
    margin-bottom: 0.3rem;
  }

  .pagination-title {
    font-family: var(--font-sans);
    font-size: 0.98rem;
    font-weight: 700;
  }

  /* On this page drawer */
  .toc-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    opacity: 0;
    pointer-events: none;
    z-index: 150;
    transition: opacity var(--dur-base) var(--ease-out);
  }

  .toc-backdrop.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .toc-sheet {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    max-width: 520px;
    margin: 0 auto;
    max-height: 75vh;
    border-radius: var(--radius-outer) var(--radius-outer) 0 0;
    padding: 1.25rem 1rem calc(1.5rem + env(safe-area-inset-bottom, 0px));
    transform: translateY(105%);
    transition: transform var(--dur-settle) var(--ease-out);
    z-index: 200;
    display: flex;
    flex-direction: column;
  }

  .toc-sheet.is-open {
    transform: translateY(0);
  }

  .toc-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    margin-bottom: 0.75rem;
  }

  .toc-title {
    font-family: var(--font-comic);
    font-size: 1.2rem;
    color: var(--color-jade-text);
  }

  .toc-list {
    list-style: none;
    overflow-y: auto;
    padding-right: 0.5rem;
  }

  .toc-item {
    margin-bottom: 0.25rem;
  }

  .toc-link {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    min-height: 44px;
    text-decoration: none;
    color: var(--theme-text-muted);
    font-family: var(--font-sans);
    font-size: 0.88rem;
    border-radius: 8px;
    transition: background var(--dur-fast), color var(--dur-fast);
  }

  .toc-link:hover,
  .toc-link:focus-visible {
    background: rgba(255, 255, 255, 0.08);
    color: var(--theme-text);
  }

  .toc-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.2);
    flex-shrink: 0;
  }

  .toc-dot.is-read {
    background: var(--color-jade);
    box-shadow: 0 0 6px var(--color-jade);
  }

  .toc-num {
    font-weight: 700;
    font-size: 0.8rem;
    color: var(--color-steel-text);
    flex-shrink: 0;
  }

  .toc-text {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>

<script>
  import { subscribeLedger } from '../../scripts/storage-ledger';

  function initChapterPage() {
    // Scroll progress bar & auto-hiding sticky header
    const progressBar = document.getElementById('chapter-progress-bar');
    const stickyHeader = document.querySelector('.sticky-chapter-header');
    let lastScrollY = window.scrollY;
    let scrollUpAccumulator = 0;

    window.addEventListener('scroll', () => {
      const currentScrollY = window.scrollY;
      const delta = currentScrollY - lastScrollY;

      const scrollTotal = document.documentElement.scrollHeight - window.innerHeight;
      const progress = scrollTotal > 0 ? (currentScrollY / scrollTotal) * 100 : 0;
      if (progressBar) progressBar.style.width = `${Math.min(100, Math.max(0, progress))}%`;

      if (stickyHeader) {
        if (currentScrollY < 60) {
          stickyHeader.classList.remove('is-scrolled-hidden');
          scrollUpAccumulator = 0;
        } else if (delta > 8) {
          // Scrolling down: hide to maximize reading viewport
          stickyHeader.classList.add('is-scrolled-hidden');
          scrollUpAccumulator = 0;
        } else if (delta < -8) {
          // Scrolling up: reveal header smoothly
          scrollUpAccumulator += Math.abs(delta);
          if (scrollUpAccumulator > 25) {
            stickyHeader.classList.remove('is-scrolled-hidden');
          }
        }
      }

      lastScrollY = currentScrollY;
    }, { passive: true });

    // TOC drawer
    const tocSheet = document.getElementById('toc-sheet');
    const tocBackdrop = document.getElementById('toc-backdrop');
    const openTocBtn = document.getElementById('open-toc-btn');
    const closeTocBtn = document.getElementById('close-toc-btn');

    function openToc() {
      if (tocSheet) {
        tocSheet.inert = false;
        tocSheet.setAttribute('aria-hidden', 'false');
        tocSheet.classList.add('is-open');
      }
      tocBackdrop?.classList.add('is-open');
    }

    function closeToc() {
      if (tocSheet) {
        tocSheet.classList.remove('is-open');
        tocSheet.inert = true;
        tocSheet.setAttribute('aria-hidden', 'true');
      }
      tocBackdrop?.classList.remove('is-open');
    }

    openTocBtn?.addEventListener('click', openToc);
    closeTocBtn?.addEventListener('click', closeToc);
    tocBackdrop?.addEventListener('click', closeToc);

    // Sync TOC dots
    subscribeLedger((state) => {
      const readSet = new Set(state.readTipIds);
      document.querySelectorAll('.toc-link').forEach((link) => {
        const tipId = (link as HTMLElement).dataset.tipId;
        const dot = link.querySelector('.toc-dot');
        if (tipId && dot) {
          if (readSet.has(tipId)) {
            dot.classList.add('is-read');
          } else {
            dot.classList.remove('is-read');
          }
        }
      });
    });

    // Close TOC on clicking link
    document.querySelectorAll('.toc-link').forEach((link) => {
      link.addEventListener('click', closeToc);
    });

    // Particle burst celebration on non-calm chapters
    const celebrationEl = document.getElementById('chapter-celebration');
    if (celebrationEl) {
      let burstFired = false;
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && !burstFired) {
            burstFired = true;
            import('../../cast/particle-burst').then(({ triggerChapterCompleteBurst }) => {
              triggerChapterCompleteBurst();
            });
            observer.disconnect();
          }
        });
      }, { threshold: 0.3 });
      observer.observe(celebrationEl);
    }
  }

  if (typeof window !== 'undefined') {
    document.addEventListener('astro:page-load', initChapterPage);
  }
</script>